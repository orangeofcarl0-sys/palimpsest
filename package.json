{
  "name": "palimpsest-dsh",
  "version": "0.1.2",
  "description": "User-friendly multi-agent orchestration plugin for DSH, built on Ordarium Safe Actions",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./advanced": {
      "types": "./dist/src/advanced.d.ts",
      "import": "./dist/src/advanced.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "pnpm run build && vitest run",
    "test:watch": "vitest",
    "check": "pnpm run test",
    "build:web": "vite build --config web/vite.config.ts"
  },
  "dependencies": {
    "@ordarium/core": "https://github.com/orangeofcarl0-sys/ordarium/releases/download/ordarium-v1.2.0/ordarium-core-1.2.0.tgz",
    "@ordarium/host-kit": "https://github.com/orangeofcarl0-sys/ordarium/releases/download/ordarium-v1.2.0/ordarium-host-kit-1.2.0.tgz",
    "@ordarium/ledger-sqlite": "https://github.com/orangeofcarl0-sys/ordarium/releases/download/ordarium-v1.2.0/ordarium-ledger-sqlite-1.2.0.tgz"
  },
  "devDependencies": {
    "@ordarium/testing": "https://github.com/orangeofcarl0-sys/ordarium/releases/download/ordarium-v1.2.0/ordarium-testing-1.2.0.tgz",
    "@types/node": "26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "@xyflow/react": "^12.11.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "7.0.2",
    "vite": "^7.3.6",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "license": "MIT",
  "bin": {
    "palimpsest": "./dist/src/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/orangeofcarl0-sys/palimpsest.git"
  }
}
