{
  "name": "palimpsest-dsh",
  "version": "0.1.2",
  "description": "Palimpsest is an operating environment for persistent AI workers to coordinate work, shared boundaries, commitments, runtime organization, and long-horizon collaboration over Ordarium-safe effects",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./advanced": {
      "types": "./dist/src/advanced.d.ts",
      "import": "./dist/src/advanced.js"
    },
    "./procedures": {
      "types": "./dist/src/procedures/index.d.ts",
      "import": "./dist/src/procedures/index.js"
    },
    "./project-intent": {
      "types": "./dist/src/project_intent/index.d.ts",
      "import": "./dist/src/project_intent/index.js"
    },
    "./project-collaboration": {
      "types": "./dist/src/project_collaboration/index.d.ts",
      "import": "./dist/src/project_collaboration/index.js"
    },
    "./institutional-learning": {
      "types": "./dist/src/institutional_learning/index.d.ts",
      "import": "./dist/src/institutional_learning/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "pnpm run build && vitest run",
    "test:watch": "vitest",
    "check": "pnpm run test",
    "build:web": "vite build --config web/vite.config.ts",
    "pretest:e2e": "pnpm run build && pnpm run build:web",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "dogfood:live": "pnpm run build && node scripts/dogfood/live-federation.mjs",
    "architecture:write": "pnpm run build && node scripts/audit/module-architecture.mjs --write",
    "architecture:check": "pnpm run build && node scripts/audit/module-architecture.mjs --check",
    "architecture:check-public-api": "pnpm run build && node scripts/audit/module-architecture.mjs --check-public-api",
    "release:consumer-smoke": "node scripts/release/consumer-smoke.mjs",
    "gate:d2-live": "node scripts/gates/d2-live-gate.mjs",
    "gate:d4-live": "node scripts/gates/d4-live-gate.mjs",
    "gate:d5-live": "node scripts/gates/d5-live-gate.mjs",
    "gate:e1-k-live": "node scripts/gates/e1k-live-gate.mjs",
    "gate:e2-i-live": "node scripts/gates/e2i-live-gate.mjs",
    "gate:e3-c-live": "node scripts/gates/e3c-live-gate.mjs",
    "gate:e4-l-live": "node scripts/gates/e4l-live-gate.mjs",
    "gate:e5-p-live": "node scripts/gates/e5p-live-gate.mjs",
    "gate:e-live": "node scripts/gates/e-live-gate.mjs",
    "gate:r1-l-live": "node scripts/gates/r1l-live-gate.mjs",
    "r1r:gate-a": "node scripts/r1r/gate-a.mjs",
    "r1r:calibrate": "node scripts/r1r/calibrate.mjs",
    "r1r:matrix": "node scripts/r1r/matrix.mjs",
    "r1r:evidence": "node scripts/r1r/evidence.mjs",
    "gate:r1-s-conformance": "node scripts/r1s/conformance.mjs",
    "gate:r1-s-live": "node scripts/gates/r1s-live-gate.mjs",
    "gate:r1-h-conformance": "node scripts/r1h/conformance.mjs",
    "gate:r1-h-live": "node scripts/gates/r1h-live-gate.mjs",
    "gate:r1-hr-conformance": "node scripts/r1hr/conformance.mjs",
    "gate:r1-hr-clean-env": "node scripts/r1hr/clean-env.mjs",
    "gate:r1-hc-conformance": "node scripts/r1hc/conformance.mjs",
    "gate:r1-hc-live": "node scripts/gates/r1hc-live-gate.mjs"
  },
  "dependencies": {
    "@ordarium/core": "https://github.com/orangeofcarl0-sys/ordarium/releases/download/ordarium-v1.3.1/ordarium-core-1.3.1.tgz",
    "@ordarium/host-kit": "https://github.com/orangeofcarl0-sys/ordarium/releases/download/ordarium-v1.3.1/ordarium-host-kit-1.3.1.tgz",
    "@ordarium/ledger-sqlite": "https://github.com/orangeofcarl0-sys/ordarium/releases/download/ordarium-v1.3.1/ordarium-ledger-sqlite-1.3.1.tgz"
  },
  "devDependencies": {
    "@ordarium/testing": "https://github.com/orangeofcarl0-sys/ordarium/releases/download/ordarium-v1.3.1/ordarium-testing-1.3.1.tgz",
    "@playwright/test": "^1.63.0",
    "@types/node": "26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "@xyflow/react": "^12.11.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "7.0.2",
    "vite": "^7.3.6",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "license": "MIT",
  "bin": {
    "palimpsest": "./dist/src/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/orangeofcarl0-sys/palimpsest.git"
  }
}
