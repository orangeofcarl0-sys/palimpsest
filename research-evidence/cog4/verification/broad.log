  ],
  "requiredFacts": [
    {
      "fact": "project and Attempt identity",
      "obtainable": "YES, canonical — but only through the report path, which requires a successful observation"
    },
    {
      "fact": "host Job identity",
      "obtainable": "host-local only; not durable"
    },
    {
      "fact": "Worker process/session identity",
      "obtainable": "PARTIAL — a child pid exists while alive; nothing durable records it"
    },
    {
      "fact": "observed exit/close or effective fencing",
      "obtainable": "NO — see the fencing audit"
    },
    {
      "fact": "relevant failure kind",
      "obtainable": "YES, as a host-local string"
    },
    {
