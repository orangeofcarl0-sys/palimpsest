{
  "kind": "R3-WR5 Gate B §8 — durable host failure evidence",
  "existingSources": [
    {
      "source": "WorkWorkerExecutionOutcome {kind:\"HOST_FAILURE\"}",
      "where": "src/deployment/work_worker.ts",
