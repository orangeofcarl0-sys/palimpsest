diff --git a/scripts/pnwf/software/self-maintenance-direct-guard-control.mjs b/scripts/pnwf/software/self-maintenance-direct-guard-control.mjs
new file mode 100644
index 0000000..5dc5018
--- /dev/null
+++ b/scripts/pnwf/software/self-maintenance-direct-guard-control.mjs
@@ -0,0 +1,117 @@
+/**
+ * Negative control for the direct-delivery guard.
+ *
+ * The same sealed shape as `self-maintenance-direct-guard.mjs` — a prior DELIVER conclusion, then a
+ * prepared review merged without `conclude` — but the guard hook is removed first. If the journal
+ * still gains a refreshed conclusion, the positive oracle would be measuring something other than
+ * the guard. This control must end with the OLD artifact commit, the pulse's RECORD action still
+ * pointing at the new head, and no invented principal judgement.
+ */
+import { execFileSync } from "node:child_process";
+import { mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { pathToFileURL } from "node:url";
+
+const candidateRoot = process.cwd();
+const { installProduct } = await import(pathToFileURL(join(candidateRoot, "dist/src/product.js")));
+const root = mkdtempSync(join(tmpdir(), "maintenance-direct-guard-control-"));
+const git = (...args) => execFileSync("git", ["-C", root, ...args], { encoding: "utf8" }).trim();
+const commit = (path, message) => {
+  git("add", "--", path);
+  git("-c", "user.name=Fixture", "-c", "user.email=fixture@example.invalid", "commit", "-qm", message);
+  return git("rev-parse", "HEAD");
+};
+
+git("init", "-q");
+writeFileSync(join(root, "maintenance.md"), "Maintenance basis\n");
+const basis = commit("maintenance.md", "Initial project basis");
+
+const stateDir = mkdtempSync(join(tmpdir(), "maintenance-direct-guard-control-state-"));
+const deployment = installProduct({ tools: { register: () => () => undefined } }, {
+  projectId: "direct-guard-control",
+  repository: root,
+  stateDir,
+  execution: "in-place",
+  toolProfile: "normal",
+});
+
+let ordinal = 0;
+function call(name, args) {
+  const tool = deployment.tools.find(entry => entry.name === name);
+  if (!tool) throw new Error(`Missing ordinary tool ${name}`);
+  const callId = `direct-guard-control-${++ordinal}`;
+  return tool.execute(args, { name, callId, rootCallId: callId, arguments: args, signal: AbortSignal.timeout(30_000) });
+}
+const conclusions = async () => (await deployment.application.projectWorkspace.journal())
+  .flatMap(({ entry }) => {
+    const marker = "<!-- pc1-episode-conclusion:v1 -->";
+    const at = entry.body.indexOf(marker);
+    if (at < 0) return [];
+    try {
+      return [{ entryId: entry.entryId, conclusion: JSON.parse(entry.body.slice(at + marker.length).trim()) }];
+    } catch {
+      return [];
+    }
+  });
+
+let disposed = false;
+try {
+  await call("palimpsest_start", {
+    projectId: "direct-guard-control",
+    goal: "Show the loss without the direct-delivery guard.",
+    headCommit: basis,
+    tasks: [],
+  });
+  writeFileSync(join(root, "MAINTENANCE-REVIEW.md"), "# Cold handover maintenance review\n\nREADY A\n");
+  const reviewA = commit("MAINTENANCE-REVIEW.md", "Preserve review A");
+  const first = await call("palimpsest_work", {
+    action: "conclude",
+    intent: "DELIVER",
+    artifacts: ["MAINTENANCE-REVIEW.md"],
+    statement: "Deliver the revalidated cold-handover review.",
+  });
+  const before = await conclusions();
+
+  // Remove the guard exactly as a pre-fix deployment would not have it.
+  rmSync(join(root, ".git/hooks/post-commit"), { force: true });
+  rmSync(join(root, ".git/hooks/post-merge"), { force: true });
+  rmSync(join(root, ".git/palimpsest"), { recursive: true, force: true });
+
+  writeFileSync(join(root, "MAINTENANCE-REVIEW.md"), "# Cold handover maintenance review\n\nREADY B\n");
+  const branch = git("branch", "--show-current");
+  git("switch", "-q", "-c", "replay");
+  const reviewB = commit("MAINTENANCE-REVIEW.md", "Revise review B");
+  git("switch", "-q", branch);
+  git("merge", "--quiet", "--ff-only", "replay");
+  const after = await conclusions();
+  const latest = after.filter(({ conclusion }) => conclusion.intent === "DELIVER").at(-1) ?? null;
+  const latestArtifact = latest?.conclusion?.check?.artifacts?.find(state => state.path === "MAINTENANCE-REVIEW.md") ?? null;
+  const pulse = await call("palimpsest_continuity", { action: "pulse" });
+  const canonicalStatus = deployment.controller.status();
+  await deployment.dispose();
+  disposed = true;
+
+  const checks = {
+    principalDeliveryRecorded: first?.state === "RECORDED" && before.length === 1,
+    noRefreshedConclusionWithoutGuard: after.length === 1 && latest?.conclusion?.conclusionId === before[0]?.conclusion?.conclusionId,
+    latestArtifactStillAtOldCommit: latestArtifact?.commit === reviewA && latestArtifact?.commit !== reviewB,
+    pulseStillRequiresRecord: pulse.requiredAction?.kind === "RECORD_DIRECT_DELIVERY" &&
+      pulse.requiredAction?.repositoryHead === reviewB,
+    episodeNotReused: pulse.episode?.current !== true || pulse.episode?.state !== "DELIVERED",
+    canonicalBasisUnchanged: canonicalStatus.headCommit === basis,
+  };
+  console.log("DIRECT_GUARD_CONTROL " + JSON.stringify({
+    basis,
+    reviewA,
+    reviewB,
+    conclusionCounts: { before: before.length, after: after.length },
+    latestArtifact,
+    requiredAction: pulse.requiredAction ?? null,
+    episode: { state: pulse.episode?.state, current: pulse.episode?.current },
+    checks,
+  }));
+  process.exitCode = Object.values(checks).every(Boolean) ? 0 : 1;
+} finally {
+  if (!disposed) await deployment.dispose().catch(() => undefined);
+}
diff --git a/scripts/pnwf/software/self-maintenance-direct-guard.mjs b/scripts/pnwf/software/self-maintenance-direct-guard.mjs
new file mode 100644
index 0000000..9e5da65
--- /dev/null
+++ b/scripts/pnwf/software/self-maintenance-direct-guard.mjs
@@ -0,0 +1,215 @@
+/**
+ * Independent replay for the "principal merges and stops without conclude" gap.
+ *
+ * The sealed maintenance rejection is a non-compliant session: pulse → `git merge` → reply, with no
+ * `palimpsest_work action=conclude`. Advice in the pulse cannot make that session call a tool, and
+ * the product must not invent a new principal judgement. This oracle reproduces the durable part of
+ * the loss and checks the guard's actual effect:
+ *
+ *   - a prior principal DELIVER conclusion exists for MAINTENANCE-REVIEW.md;
+ *   - a later clean direct commit/merge moves that same artifact;
+ *   - without the guard, the journal still ends at the old artifact commit (negative control);
+ *   - with the guard, exactly one refreshed DELIVER conclusion records the new commit/digest,
+ *     preserves the principal's statement, and leaves the canonical head/tasks/promotions alone;
+ *   - unrelated, empty, and dirty commits do not refresh; a project with no prior DELIVER gets no
+ *     invented conclusion; dispose removes only its own hooks.
+ */
+import { execFileSync } from "node:child_process";
+import { createHash } from "node:crypto";
+import { mkdirSync, mkdtempSync, readFileSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { pathToFileURL } from "node:url";
+
+const candidateRoot = process.cwd();
+const { installProduct } = await import(pathToFileURL(join(candidateRoot, "dist/src/product.js")));
+const root = mkdtempSync(join(tmpdir(), "maintenance-direct-guard-"));
+const git = (...args) => execFileSync("git", ["-C", root, ...args], { encoding: "utf8" }).trim();
+const commit = (path, message) => {
+  git("add", "--", path);
+  git("-c", "user.name=Fixture", "-c", "user.email=fixture@example.invalid", "commit", "-qm", message);
+  return git("rev-parse", "HEAD");
+};
+git("init", "-q");
+writeFileSync(join(root, "maintenance.md"), "Maintenance basis\n");
+const basis = commit("maintenance.md", "Initial project basis");
+
+const stateDir = mkdtempSync(join(tmpdir(), "maintenance-direct-guard-state-"));
+const deployment = installProduct({ tools: { register: () => () => undefined } }, {
+  projectId: "direct-guard-repro",
+  repository: root,
+  stateDir,
+  execution: "in-place",
+  toolProfile: "normal",
+  standard: { statement: "Preserve a principal's existing delivery when Git moves without a new conclusion.", clauses: [], derivedFrom: [], confirmed: true, notes: [] },
+});
+
+let ordinal = 0;
+function call(name, args) {
+  const tool = deployment.tools.find(entry => entry.name === name);
+  if (!tool) throw new Error(`Missing ordinary tool ${name}`);
+  const callId = `direct-guard-probe-${++ordinal}`;
+  return tool.execute(args, { name, callId, rootCallId: callId, arguments: args, signal: AbortSignal.timeout(30_000) });
+}
+
+const conclusions = async () => (await deployment.application.projectWorkspace.journal())
+  .flatMap(({ entry }) => {
+    const at = entry.body.indexOf("<!-- pc1-episode-conclusion:v1 -->");
+    if (at < 0) return [];
+    try {
+      const parsed = JSON.parse(entry.body.slice(at + "<!-- pc1-episode-conclusion:v1 -->".length).trim());
+      return [{ entryId: entry.entryId, conclusion: parsed }];
+    } catch {
+      return [];
+    }
+  });
+const latestDelivery = list => list.filter(({ conclusion }) => conclusion.intent === "DELIVER").at(-1) ?? null;
+const artifactAt = (record, path) => record?.conclusion?.check?.artifacts?.find(state => state.path === path) ?? null;
+let disposed = false;
+
+try {
+  await call("palimpsest_start", {
+    projectId: "direct-guard-repro",
+    goal: "Preserve the principal's delivery across a direct Git advance.",
+    headCommit: basis,
+    tasks: [],
+  });
+
+  // A principal records DELIVER for review A. This is the only judgement the guard may refresh.
+  writeFileSync(join(root, "MAINTENANCE-REVIEW.md"), "# Cold handover maintenance review\n\nREADY A\n");
+  const reviewA = commit("MAINTENANCE-REVIEW.md", "Preserve review A");
+  const firstDelivery = await call("palimpsest_work", {
+    action: "conclude",
+    intent: "DELIVER",
+    artifacts: ["MAINTENANCE-REVIEW.md"],
+    statement: "Deliver the revalidated cold-handover review.",
+  });
+  const afterFirst = await conclusions();
+  const first = latestDelivery(afterFirst);
+
+  // The sealed shape: a prepared review branch is fast-forward merged. No conclude follows it.
+  writeFileSync(join(root, "MAINTENANCE-REVIEW.md"), "# Cold handover maintenance review\n\nREADY B\n");
+  const branch = git("branch", "--show-current");
+  git("switch", "-q", "-c", "replay");
+  const reviewB = commit("MAINTENANCE-REVIEW.md", "Revise review B");
+  git("switch", "-q", branch);
+  git("merge", "--quiet", "--ff-only", "replay");
+  const afterMerge = await conclusions();
+  const merged = latestDelivery(afterMerge);
+  const mergedArtifact = artifactAt(merged, "MAINTENANCE-REVIEW.md");
+  const mergedDigest = createHash("sha256")
+    .update(execFileSync("git", ["-C", root, "cat-file", "blob", `${reviewB}:MAINTENANCE-REVIEW.md`], { maxBuffer: 8 * 1024 * 1024 }))
+    .digest("hex");
+  const pulseAfterMerge = await call("palimpsest_continuity", { action: "pulse" });
+
+  // Idempotence: an empty commit and an unrelated commit must not add a second refresh.
+  const empty = (() => {
+    git("-c", "user.name=Fixture", "-c", "user.email=fixture@example.invalid", "commit", "-q", "--allow-empty", "-m", "Empty");
+    return git("rev-parse", "HEAD");
+  })();
+  const afterEmpty = await conclusions();
+  writeFileSync(join(root, "maintenance.md"), "Maintenance basis, unrelated edit\n");
+  const unrelated = commit("maintenance.md", "Unrelated maintenance note");
+  const afterUnrelated = await conclusions();
+
+  // A dirty worktree is not a final artifact: a staged review commit plus an unstaged file must
+  // not refresh, because the hook cannot prove the named bytes are the delivered bytes.
+  writeFileSync(join(root, "MAINTENANCE-REVIEW.md"), "# Cold handover maintenance review\n\nREADY C\n");
+  git("add", "--", "MAINTENANCE-REVIEW.md");
+  writeFileSync(join(root, "dirty-note.txt"), "not part of the commit\n");
+  git("-c", "user.name=Fixture", "-c", "user.email=fixture@example.invalid", "commit", "-qm", "Review C with a dirty note");
+  const reviewC = git("rev-parse", "HEAD");
+  const afterDirty = await conclusions();
+
+  // A project with no prior DELIVER has no principal statement to preserve: the guard must not
+  // invent a conclusion. Use the same repository/state but a fresh project id is not possible
+  // without a second deployment; instead check the negative shape at the journal level by testing
+  // the guard's precondition through the first project's empty history is not available. The
+  // sealed rejection's no-prior-conclusion case is covered by the first commit above: the hook ran
+  // on reviewA before the conclusion existed and added nothing.
+  const afterReviewACommit = afterFirst.length;
+
+  const { installDirectDeliveryGuard } = await import(
+    pathToFileURL(join(candidateRoot, "dist/src/deployment/direct_delivery_guard.js"))
+  );
+  const conflictRoot = mkdtempSync(join(tmpdir(), "maintenance-direct-guard-conflict-"));
+  execFileSync("git", ["-C", conflictRoot, "init", "-q"]);
+  mkdirSync(join(conflictRoot, ".git/hooks"), { recursive: true });
+  const foreignHook = "#!/bin/sh\necho foreign hook\n";
+  writeFileSync(join(conflictRoot, ".git/hooks/post-commit"), foreignHook, { mode: 0o755 });
+  const conflict = installDirectDeliveryGuard({
+    repository: conflictRoot,
+    projectId: "direct-guard-conflict",
+    journalPath: join(stateDir, "journal.sqlite"),
+    orchestrationPath: join(stateDir, "palimpsest.sqlite"),
+    moduleUrl: pathToFileURL(join(candidateRoot, "dist/src/deployment/direct_delivery_guard.js")).href,
+  });
+  const conflictResult = {
+    installed: conflict.installed,
+    postCommit: readFileSync(join(conflictRoot, ".git/hooks/post-commit"), "utf8"),
+    postMergeExists: (() => { try { readFileSync(join(conflictRoot, ".git/hooks/post-merge"), "utf8"); return true; } catch { return false; } })(),
+  };
+
+  const status = deployment.controller.status();
+  const hooksBeforeDispose = {
+    postCommit: readFileSync(join(root, ".git/hooks/post-commit"), "utf8").includes("palimpsest-direct-delivery-guard"),
+    postMerge: readFileSync(join(root, ".git/hooks/post-merge"), "utf8").includes("palimpsest-direct-delivery-guard"),
+  };
+  await deployment.dispose();
+  disposed = true;
+  const hooksAfterDispose = {
+    postCommitExists: (() => { try { readFileSync(join(root, ".git/hooks/post-commit"), "utf8"); return true; } catch { return false; } })(),
+    postMergeExists: (() => { try { readFileSync(join(root, ".git/hooks/post-merge"), "utf8"); return true; } catch { return false; } })(),
+  };
+
+  const checks = {
+    principalDeliveryRecorded: firstDelivery?.state === "RECORDED" &&
+      artifactAt(first, "MAINTENANCE-REVIEW.md")?.commit === reviewA,
+    guardInstalledHooks: hooksBeforeDispose.postCommit && hooksBeforeDispose.postMerge,
+    foreignHookNotReplaced: conflictResult.installed === false &&
+      conflictResult.postCommit === foreignHook && conflictResult.postMergeExists === false,
+    guardRefreshedAfterMergeWithoutConclude: afterMerge.length === 2 &&
+      merged?.conclusion?.recordedAt !== first?.conclusion?.recordedAt &&
+      mergedArtifact?.commit === reviewB &&
+      mergedArtifact?.digest === mergedDigest &&
+      mergedArtifact?.present === true && mergedArtifact?.tracked === true && mergedArtifact?.committed === true,
+    guardPreservedPrincipalStatement: typeof merged?.conclusion?.statement === "string" &&
+      merged.conclusion.statement.includes("Deliver the revalidated cold-handover review.") &&
+      merged.conclusion.statement.includes("Direct-delivery guard refreshed provenance"),
+    guardPreservedEarlierRecord: afterMerge.some(({ conclusion }) => conclusion.conclusionId === first?.conclusion?.conclusionId) === true,
+    pulseReusesRefreshedDelivery: pulseAfterMerge.requiredAction == null &&
+      pulseAfterMerge.episode?.state === "DELIVERED" &&
+      pulseAfterMerge.episode?.current === true,
+    emptyCommitNoOp: afterEmpty.length === 2,
+    unrelatedCommitNoOp: afterUnrelated.length === 2,
+    dirtyWorktreeNoOp: afterDirty.length === 2,
+    noInventionBeforePriorConclusion: afterReviewACommit === 1,
+    canonicalBasisUnchanged: status.headCommit === basis && status.attempts.length === 0 && status.promotions.length === 0,
+    disposeRemovedOwnHooks: hooksAfterDispose.postCommitExists === false && hooksAfterDispose.postMergeExists === false,
+  };
+
+  console.log("DIRECT_GUARD " + JSON.stringify({
+    basis,
+    reviewA,
+    reviewB,
+    empty,
+    unrelated,
+    reviewC,
+    first: first?.conclusion ?? null,
+    merged: merged?.conclusion ?? null,
+    counts: { afterFirst: afterFirst.length, afterMerge: afterMerge.length, afterEmpty: afterEmpty.length, afterUnrelated: afterUnrelated.length, afterDirty: afterDirty.length },
+    pulse: { requiredAction: pulseAfterMerge.requiredAction ?? null, episode: pulseAfterMerge.episode?.state, current: pulseAfterMerge.episode?.current },
+    hooks: { before: hooksBeforeDispose, after: hooksAfterDispose },
+    conflict: { installed: conflictResult.installed, postMergeExists: conflictResult.postMergeExists },
+    checks,
+  }));
+  process.exitCode = Object.values(checks).every(Boolean) ? 0 : 1;
+} finally {
+  if (!disposed) {
+    try {
+      await deployment.dispose();
+    } catch {
+      /* already disposed */
+    }
+  }
+}
diff --git a/scripts/pnwf/software/self-maintenance-sealed-guard.mjs b/scripts/pnwf/software/self-maintenance-sealed-guard.mjs
new file mode 100644
index 0000000..b367716
--- /dev/null
+++ b/scripts/pnwf/software/self-maintenance-sealed-guard.mjs
@@ -0,0 +1,151 @@
+/**
+ * Sealed-input replay for the direct-delivery guard.
+ *
+ * Unlike the synthetic oracle, this replays the exact owner databases and prepared-review commits
+ * sealed under `evidence/`. The rejection receipts expected one delivery record for
+ * MAINTENANCE-REVIEW.md at d6e5558 (WITHOUT) and b5835cd (WITH); the sealed session stopped after
+ * `git merge` and never called `conclude`.
+ *
+ * This script copies the owner databases into a temporary state directory, seeds a temporary Git
+ * repository from the real bundles, and merges the prepared review exactly as the sealed session
+ * did. It runs each arm twice: once with the guard removed (the pre-fix shape) and once with the
+ * guard installed. The guard must refresh exactly one DELIVER record at the receipt's expected
+ * commit, preserve the principal's statement and leave the canonical project row untouched.
+ *
+ * The sealed inputs are intentionally not part of the tracked tree. When they are absent, the
+ * script reports SKIP instead of pretending to verify anything.
+ */
+import { execFileSync } from "node:child_process";
+import { createHash } from "node:crypto";
+import { cpSync, existsSync, mkdtempSync, readFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { pathToFileURL } from "node:url";
+import { DatabaseSync } from "node:sqlite";
+
+const here = process.cwd();
+const evidence = join(here, "evidence");
+const inputs = {
+  basis: join(evidence, "basis.bundle"),
+  owners: join(evidence, "case-3/owners"),
+  candidate: {
+    WITHOUT: join(evidence, "case-1/candidate.bundle"),
+    WITH: join(evidence, "case-2/candidate.bundle"),
+  },
+  receipt: {
+    WITHOUT: join(evidence, "rejection/without/receipt.json"),
+    WITH: join(evidence, "rejection/with/receipt.json"),
+  },
+};
+const missing = Object.entries(inputs)
+  .flatMap(([name, value]) =>
+    typeof value === "string" ? [[name, value]] : Object.entries(value).map(([arm, path]) => [`${name}.${arm}`, path]),
+  )
+  .filter(([, path]) => !existsSync(path));
+if (missing.length > 0) {
+  console.log("SEALED_GUARD_SKIP " + JSON.stringify({ missing: missing.map(([name]) => name) }));
+  process.exit(0);
+}
+
+const { installDirectDeliveryGuard } = await import(pathToFileURL(join(here, "dist/src/deployment/direct_delivery_guard.js")));
+const { parseEpisodeConclusion } = await import(pathToFileURL(join(here, "dist/src/project_continuity/episode.js")));
+
+function seed(arm) {
+  const repository = mkdtempSync(join(tmpdir(), `sealed-guard-${arm.toLowerCase()}-repo-`));
+  const state = mkdtempSync(join(tmpdir(), `sealed-guard-${arm.toLowerCase()}-state-`));
+  cpSync(join(inputs.owners, "journal.sqlite"), join(state, "journal.sqlite"));
+  cpSync(join(inputs.owners, "palimpsest.sqlite"), join(state, "palimpsest.sqlite"));
+  const git = (...args) => execFileSync("git", ["-C", repository, ...args], { encoding: "utf8" }).trim();
+  git("init", "-q");
+  git("fetch", "-q", inputs.basis, "HEAD:refs/heads/basis");
+  git("fetch", "-q", inputs.candidate[arm], "HEAD:refs/heads/replay");
+  git("checkout", "-q", "-B", "main", "refs/heads/basis");
+  git("config", "user.name", "Sealed replay");
+  git("config", "user.email", "sealed@example.invalid");
+  return { repository, state, git };
+}
+
+function conclusions(state) {
+  const db = new DatabaseSync(join(state, "journal.sqlite"));
+  const rows = db.prepare("SELECT event_id, payload_json FROM project_journal_events ORDER BY seq").all();
+  db.close();
+  const found = [];
+  for (const row of rows) {
+    const payload = JSON.parse(row.payload_json);
+    if (payload.entry === undefined) continue;
+    const conclusion = parseEpisodeConclusion(payload.entry.body);
+    if (conclusion !== null) found.push({ entryId: payload.entry.entryId, conclusion });
+  }
+  return found;
+}
+
+function canonical(state) {
+  const db = new DatabaseSync(join(state, "palimpsest.sqlite"));
+  const row = db.prepare("SELECT revision, digest, head_commit FROM projects").get();
+  db.close();
+  return row;
+}
+
+const checks = {};
+for (const arm of ["WITHOUT", "WITH"]) {
+  const expected = JSON.parse(readFileSync(inputs.receipt[arm], "utf8")).expected;
+  const before = { ...seed(arm) };
+  const beforeConclusions = conclusions(before.state);
+  const beforeLatest = beforeConclusions.filter(({ conclusion }) => conclusion.intent === "DELIVER").at(-1) ?? null;
+  const mergeBefore = before.git("rev-parse", "HEAD");
+
+  // Control arm: remove the guard before the merge, exactly the sealed pre-fix shape.
+  const control = { ...seed(arm) };
+  const controlConclusions = conclusions(control.state);
+  control.git("merge", "--quiet", "--ff-only", "replay");
+  const controlAfter = conclusions(control.state);
+  const controlLatest = controlAfter.filter(({ conclusion }) => conclusion.intent === "DELIVER").at(-1) ?? null;
+  checks[`${arm}_control_does_not_record`] =
+    controlAfter.length === controlConclusions.length &&
