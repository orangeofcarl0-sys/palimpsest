+/**
+ * DIRECT-DELIVERY GUARD — preserve a principal's DELIVER record when Git advances without one.
+ *
+ * The sealed maintenance rejection exposed a concrete loss: a session can merge a prepared review
+ * and stop without calling `palimpsest_work action=conclude`. The next session then sees only a
+ * direct Git commit; the journal has no record for the new bytes. Advice in the pulse cannot make a
+ * non-compliant executor call `conclude`, and silently inventing a new judgement would exceed the
+ * product's authority.
+ *
+ * This guard is narrower than a new conclusion. It only REFRESHES the provenance of an EXISTING
+ * principal DELIVER conclusion when:
+ *   - the latest journal entry is that conclusion (no later semantic fact reopens it),
+ *   - the repository is clean and the canonical project head is an ancestor of a new direct commit,
+ *   - that commit moved at least one artifact path the principal already named.
+ *
+ * It copies the principal's statement unchanged, adds a transparent provenance-refresh suffix, and
+ * records the new artifact digests/commit. It accepts nothing, promotes nothing, advances no
+ * canonical head and never turns a non-DELIVER conclusion into one. A commit that touches no named
+ * artifact is ignored. Installation is a bounded Git post-commit/post-merge hook that always exits
+ * 0, so a failure to record can never block ordinary Git work.
+ *
+ * Layer: deployment (host-side wiring). It owns a hook file and a journal append; it owns no truth.
+ */
+import { execFileSync } from "node:child_process";
+import { createHash, randomUUID } from "node:crypto";
+import {
+  chmodSync,
+  existsSync,
+  mkdirSync,
+  readFileSync,
+  rmSync,
+  statSync,
+  writeFileSync,
+} from "node:fs";
+import { isAbsolute, join, resolve, sep } from "node:path";
+import { DatabaseSync } from "node:sqlite";
+
+import { canonicalDigest } from "../schema/canonical.js";
+import {
+  episodeConclusionBody,
+  parseEpisodeConclusion,
+  type EpisodeArtifactState,
+  type EpisodeConclusion,
+} from "../project_continuity/episode.js";
+import {
+  journalEntryRecordedEvent,
+  materializeProjectJournalEntry,
+  projectJournalView,
+  SqliteProjectJournalStore,
+} from "../project_workspace/journal.js";
+import { changedBlobPaths, gitTextRunner } from "../work/path_reuse.js";
+
+export const DIRECT_DELIVERY_GUARD_SCHEMA = "pc1-direct-delivery-guard/v1";
+export const DIRECT_DELIVERY_GUARD_MARKER = "# palimpsest-direct-delivery-guard v1";
+
+export interface DirectDeliveryGuardInstallInput {
+  readonly repository: string;
+  readonly projectId: string;
+  readonly journalPath: string;
+  readonly orchestrationPath: string;
+  /** The compiled guard module the hook imports. Derived from this module when omitted. */
+  readonly moduleUrl?: string | undefined;
+  readonly now?: (() => string) | undefined;
+}
+
+export interface DirectDeliveryGuardInstallation {
+  readonly installed: boolean;
+  readonly hooks: readonly string[];
+  readonly detail: string;
+  dispose(): void;
+}
+
+export interface DirectDeliveryGuardResult {
+  readonly recorded: boolean;
+  readonly detail: string;
+  readonly conclusionId?: string | undefined;
+}
+
+interface GuardConfig {
+  readonly schema: typeof DIRECT_DELIVERY_GUARD_SCHEMA;
+  readonly installationId: string;
+  readonly projectId: string;
+  readonly repository: string;
+  readonly journalPath: string;
+  readonly orchestrationPath: string;
+  readonly moduleUrl: string;
+  readonly installedAt: string;
+}
+
+function git(cwd: string, args: readonly string[]): string | null {
+  try {
+    return execFileSync("git", ["-C", cwd, ...args], { encoding: "utf8", maxBuffer: 8 * 1024 * 1024 }).trim();
+  } catch {
+    return null;
+  }
+}
+
+function gitBuffer(cwd: string, args: readonly string[]): Buffer | null {
+  try {
+    return execFileSync("git", ["-C", cwd, ...args], { maxBuffer: 8 * 1024 * 1024 });
+  } catch {
+    return null;
+  }
+}
+
+function resolveHookDir(repository: string): string | null {
+  const raw = git(repository, ["rev-parse", "--git-path", "hooks"]);
+  if (raw === null || raw === "" || /(^|[/\\])dev[/\\]null$/u.test(raw)) return null;
+  return isAbsolute(raw) ? raw : resolve(repository, raw);
+}
+
+function hookBody(nodePath: string, guardScript: string, configPath: string): string {
+  return [
+    "#!/bin/sh",
+    DIRECT_DELIVERY_GUARD_MARKER,
+    "# Installed by Palimpsest. It records a provenance refresh only for an existing DELIVER",
+    "# conclusion; it never blocks Git and never changes the canonical project head.",
+    `if [ -f ${JSON.stringify(guardScript)} ]; then`,
+    `  ${JSON.stringify(nodePath)} ${JSON.stringify(guardScript)} ${JSON.stringify(configPath)} >/dev/null 2>&1 || true`,
+    "fi",
+    "exit 0",
+    "",
+  ].join("\n");
+}
+
+function guardScriptBody(moduleUrl: string): string {
+  return [
+    "#!/usr/bin/env node",
+    `// ${DIRECT_DELIVERY_GUARD_MARKER.replace(/^#\s*/u, "")}`,
+    `import { runDirectDeliveryGuard } from ${JSON.stringify(moduleUrl)};`,
+    "const configPath = process.argv[2];",
+    "if (configPath) {",
+    "  const result = await runDirectDeliveryGuard(configPath);",
+    "  if (process.env.PALIMPSEST_GUARD_DEBUG === '1') process.stderr.write(JSON.stringify(result) + '\\n');",
+    "}",
+    "",
+  ].join("\n");
+}
+
+function moduleUrlForThisFile(): string {
+  const current = import.meta.url;
+  if (current.endsWith(".js")) return current;
+  // Tests run the TypeScript source; a Git hook cannot import it. Do not guess a compiled sibling:
+  // a stale dist file would make the hook execute different code than the install under test.
+  return "";
+}
+
+/**
+ * Install the two Git hooks and a config that names this exact installation. Existing hooks that
+ * are not ours are never overwritten: the guard reports that it did not install rather than
+ * replacing another tool's hook.
+ */
+export function installDirectDeliveryGuard(
+  input: DirectDeliveryGuardInstallInput,
+): DirectDeliveryGuardInstallation {
+  const repository = resolve(input.repository);
+  const gitDir = git(repository, ["rev-parse", "--absolute-git-dir"]);
+  if (gitDir === null) {
+    return Object.freeze({ installed: false, hooks: Object.freeze([]), detail: "repository is not a readable Git worktree", dispose: () => undefined });
+  }
+  const hookDir = resolveHookDir(repository);
+  if (hookDir === null) {
+    return Object.freeze({ installed: false, hooks: Object.freeze([]), detail: "Git hooks are disabled for this repository", dispose: () => undefined });
+  }
+  const moduleUrl = input.moduleUrl ?? moduleUrlForThisFile();
+  if (moduleUrl === "") {
+    return Object.freeze({ installed: false, hooks: Object.freeze([]), detail: "the compiled guard module is not available", dispose: () => undefined });
+  }
+  const installationId = randomUUID();
+  const configDir = join(gitDir, "palimpsest");
+  const configPath = join(configDir, "direct-delivery.json");
+  const guardScript = join(configDir, "direct-delivery-guard.mjs");
+  const config: GuardConfig = {
+    schema: DIRECT_DELIVERY_GUARD_SCHEMA,
+    installationId,
+    projectId: input.projectId,
+    repository,
+    journalPath: resolve(input.journalPath),
+    orchestrationPath: resolve(input.orchestrationPath),
+    moduleUrl,
+    installedAt: (input.now ?? (() => new Date().toISOString()))(),
+  };
+  try {
+    /**
+     * Preflight BOTH hooks before writing anything. A half-installed guard would report failure
+     * while leaving a live post-commit hook behind.
+     */
+    for (const name of ["post-commit", "post-merge"]) {
+      const path = join(hookDir, name);
+      if (!existsSync(path)) continue;
+      let current = "";
+      try {
+        current = readFileSync(path, "utf8");
+      } catch {
+        current = "";
+      }
+      if (!current.includes(DIRECT_DELIVERY_GUARD_MARKER)) {
+        return Object.freeze({
+          installed: false,
+          hooks: Object.freeze([]),
+          detail: `an existing ${name} hook belongs to another tool; it was not replaced`,
+          dispose: () => undefined,
+        });
+      }
+    }
+    mkdirSync(configDir, { recursive: true });
+    mkdirSync(hookDir, { recursive: true });
+    writeFileSync(guardScript, guardScriptBody(moduleUrl), "utf8");
+    chmodSync(guardScript, 0o755);
+    writeFileSync(configPath, `${JSON.stringify(config, null, 2)}\n`, "utf8");
+    const body = hookBody(process.execPath, guardScript, configPath);
+    const installedHooks: string[] = [];
+    for (const name of ["post-commit", "post-merge"]) {
+      const path = join(hookDir, name);
+      writeFileSync(path, body, "utf8");
+      chmodSync(path, 0o755);
+      installedHooks.push(name);
+    }
+    return Object.freeze({
+      installed: true,
+      hooks: Object.freeze(installedHooks),
+      detail: `direct-delivery guard installed for project ${input.projectId}`,
+      dispose: () => {
+        try {
+          const current = JSON.parse(readFileSync(configPath, "utf8")) as Partial<GuardConfig>;
+          if (current.installationId !== installationId) return;
+        } catch {
+          return;
+        }
+        for (const name of ["post-commit", "post-merge"]) {
+          const path = join(hookDir, name);
+          try {
+            if (readFileSync(path, "utf8").includes(DIRECT_DELIVERY_GUARD_MARKER)) rmSync(path, { force: true });
+          } catch {
+            /* a missing or unreadable hook is already gone */
+          }
+        }
+        rmSync(guardScript, { force: true });
+        rmSync(configPath, { force: true });
+      },
+    });
+  } catch (error) {
+    return Object.freeze({
+      installed: false,
+      hooks: Object.freeze([]),
+      detail: `guard installation failed: ${error instanceof Error ? error.message : String(error)}`,
+      dispose: () => undefined,
+    });
+  }
+}
+
+function artifactStates(
+  repository: string,
+  head: string,
+  paths: readonly string[],
+): readonly EpisodeArtifactState[] {
+  const root = resolve(repository);
+  const prefix = root.endsWith(sep) ? root : `${root}${sep}`;
+  const states: EpisodeArtifactState[] = [];
+  for (const path of paths) {
+    if (path === "" || isAbsolute(path)) continue;
+    const absolute = resolve(root, path);
+    if (!absolute.startsWith(prefix)) continue;
+    const type = git(repository, ["cat-file", "-t", `${head}:${path}`]);
+    if (type !== "blob") continue;
+    let present = false;
+    try {
+      present = statSync(absolute).isFile();
+    } catch {
+      present = false;
+    }
+    const tracked = git(repository, ["ls-files", "--error-unmatch", "--", path]) !== null;
+    const bytes = gitBuffer(repository, ["cat-file", "blob", `${head}:${path}`]);
+    if (bytes === null) continue;
+    states.push({
+      path,
+      present,
+      tracked,
+      committed: true,
+      digest: createHash("sha256").update(bytes).digest("hex"),
+      source: "WORKTREE",
+      commit: head,
+      detail: "committed at HEAD (direct-delivery guard provenance refresh)",
+    });
+  }
+  return Object.freeze(states);
+}
+
+function refreshedStatement(previous: string, head: string): string {
+  const base = previous
+    .replace(/\s*Direct-delivery guard refreshed provenance at [0-9a-f]{12}; the principal's statement is unchanged\.\s*$/u, "")
+    .trim();
+  return `${base} Direct-delivery guard refreshed provenance at ${head.slice(0, 12)}; the principal's statement is unchanged.`;
+}
+
+function sameArtifacts(
+  recorded: readonly EpisodeArtifactState[] | undefined,
+  current: readonly EpisodeArtifactState[],
+): boolean {
+  if (recorded === undefined || recorded.length !== current.length) return false;
+  const byPath = new Map(recorded.map((state) => [state.path, state]));
+  return current.every((state) => {
+    const before = byPath.get(state.path);
+    /**
+     * A later commit that leaves the blob bytes unchanged (an empty or unrelated commit) does not
+     * need a new provenance record. The recorded commit still names the same blob content.
+     */
+    return before !== undefined && before.digest === state.digest &&
+      before.present === state.present && before.tracked === state.tracked && before.committed === state.committed;
+  });
+}
+
+/**
+ * The hook entry point. It is best-effort by design: every failure returns `recorded:false` and the
+ * Git hook still exits 0. It never edits a canonical row, task, attempt or promotion.
+ */
+export async function runDirectDeliveryGuard(configPath: string): Promise<DirectDeliveryGuardResult> {
+  let config: GuardConfig;
+  try {
+    config = JSON.parse(readFileSync(configPath, "utf8")) as GuardConfig;
+  } catch (error) {
+    return Object.freeze({ recorded: false, detail: `guard config unreadable: ${error instanceof Error ? error.message : String(error)}` });
+  }
+  if (config.schema !== DIRECT_DELIVERY_GUARD_SCHEMA) {
+    return Object.freeze({ recorded: false, detail: "guard config has an unknown schema" });
+  }
+  const { repository, projectId, journalPath, orchestrationPath } = config;
+  const head = git(repository, ["rev-parse", "HEAD"]);
+  if (head === null || head === "") return Object.freeze({ recorded: false, detail: "repository HEAD is unreadable" });
+
+  let project: { revision: number; digest: string; head_commit: string } | undefined;
+  let governedWorkPending = false;
+  try {
+    const db = new DatabaseSync(orchestrationPath);
+    try {
+      project = db.prepare("SELECT revision, digest, head_commit FROM projects WHERE project_id = ?").get(projectId) as
+        | { revision: number; digest: string; head_commit: string }
+        | undefined;
+      /**
+       * A governed promotion or a live in-place attempt also advances the canonical tree. The guard
+       * is for a DIRECT outcome only; leave those commits to the existing Work settlement.
+       */
+      try {
+        governedWorkPending =
+          db.prepare("SELECT 1 FROM promotions WHERE project_id = ? AND state IN ('PREPARED','COMMITTED_UNSETTLED') LIMIT 1").get(projectId) !== undefined ||
+          db.prepare("SELECT 1 FROM attempts WHERE project_id = ? AND state IN ('CREATED','LEASED','RUNNING') LIMIT 1").get(projectId) !== undefined;
+      } catch {
+        governedWorkPending = false;
+      }
+    } finally {
+      db.close();
+    }
+  } catch (error) {
+    return Object.freeze({ recorded: false, detail: `canonical project row unreadable: ${error instanceof Error ? error.message : String(error)}` });
+  }
+  if (project === undefined) return Object.freeze({ recorded: false, detail: "canonical project row is absent" });
+  if (governedWorkPending) {
+    return Object.freeze({ recorded: false, detail: "a governed promotion or live attempt is pending; direct delivery is not refreshed" });
+  }
+  if (head === project.head_commit) return Object.freeze({ recorded: false, detail: "repository HEAD is the canonical head" });
+  if (git(repository, ["merge-base", "--is-ancestor", project.head_commit, head]) === null) {
+    return Object.freeze({ recorded: false, detail: "the direct commit does not descend from the canonical head" });
+  }
+  if ((git(repository, ["status", "--porcelain"]) ?? "unexpected") !== "") {
+    return Object.freeze({ recorded: false, detail: "the worktree is not clean" });
+  }
+  const store = new SqliteProjectJournalStore(journalPath, { busyTimeoutMs: 5000 });
+  try {
+    for (let attempt = 0; attempt < 3; attempt += 1) {
+      const events = await store.replay(projectId);
+      const entries = projectJournalView(events);
+      let latestIndex = -1;
+      let latest: EpisodeConclusion | null = null;
+      for (let index = 0; index < entries.length; index += 1) {
+        const parsed = parseEpisodeConclusion(entries[index]!.entry.body);
+        if (parsed !== null) {
+          latest = parsed;
+          latestIndex = index;
+        }
+      }
+      if (latest === null || latest.intent !== "DELIVER") {
+        return Object.freeze({ recorded: false, detail: "no DELIVER conclusion exists to refresh" });
+      }
+      // A later journal fact may reopen or reinterpret the conclusion. Only the latest entry is
+      // eligible: the guard refreshes provenance, it never overrides a newer semantic record.
+      if (latestIndex !== entries.length - 1) {
+        return Object.freeze({ recorded: false, detail: "a journal fact was recorded after the DELIVER conclusion" });
+      }
+      /**
+       * Compare from the commit the prior conclusion actually read, not always from the canonical
+       * head. An empty commit or an unrelated later commit must not make the earlier review look
+       * "changed" again merely because the canonical basis is still behind.
+       */
+      const priorCommits = new Set(
+        (latest.check.artifacts ?? [])
+          .map((state) => state.commit)
+          .filter((commit): commit is string => typeof commit === "string" && commit !== ""),
+      );
+      const recordedRevision = priorCommits.size === 1 ? [...priorCommits][0]! : project.head_commit;
+      /**
+       * A conclusion can name a commit that this checkout no longer carries (a review branch that
+       * was never fetched, a reclaimed object). Use it only when it is readable AND an ancestor of
+       * the new head; otherwise fall back to the canonical head, which is always the project basis.
+       */
+      const recordedReadable = recordedRevision !== project.head_commit &&
+        git(repository, ["cat-file", "-e", `${recordedRevision}^{commit}`]) !== null &&
+        git(repository, ["merge-base", "--is-ancestor", recordedRevision, head]) !== null;
+      const previousRevision = recordedReadable ? recordedRevision : project.head_commit;
+      const changed = changedBlobPaths(gitTextRunner(repository), previousRevision, head);
+      if (changed === null || changed.length === 0) {
+        return Object.freeze({ recorded: false, detail: "the direct advance changes no readable blob since the previous delivery" });
+      }
+      const touched = changed.filter((path) => latest!.artifacts.includes(path));
+      if (touched.length === 0) {
+        return Object.freeze({ recorded: false, detail: "the direct commit touches no artifact named by the DELIVER conclusion" });
+      }
+      const paths = [...new Set([...latest.artifacts.filter((path) => changed.includes(path)), ...changed])];
+      const states = artifactStates(repository, head, paths);
+      if (states.length === 0) return Object.freeze({ recorded: false, detail: "no named artifact is a readable blob at HEAD" });
+      if (sameArtifacts(latest.check.artifacts, states)) {
+        return Object.freeze({ recorded: false, detail: "the DELIVER conclusion already covers these exact bytes", conclusionId: latest.conclusionId });
+      }
+      const recordedAt = new Date().toISOString();
+      const body = {
+        schema: "pc1-episode-conclusion/v1" as const,
+        intent: "DELIVER" as const,
+        statement: refreshedStatement(latest.statement, head),
+        artifacts: Object.freeze(states.map((state) => state.path)),
+        waitingOn: latest.waitingOn,
+        nextStep: latest.nextStep,
+        evidenceRefs: Object.freeze([...new Set([...latest.evidenceRefs, `commit:${head}`, `journal:${entries[latestIndex]!.entry.entryId}`])]),
+        recordedAt,
+        basis: Object.freeze({ projectRevision: project.revision, projectDigest: project.digest, headCommit: project.head_commit }),
+        check: Object.freeze({
+          ...latest.check,
+          artifacts: states,
+        }),
+      };
+      const conclusion: EpisodeConclusion = Object.freeze({
+        ...body,
+        conclusionId: `episode-${canonicalDigest(body).slice(0, 24)}`,
+      });
+      const entry = materializeProjectJournalEntry({
+        projectId,
+        kind: "REFERENCE_NOTE",
+        title: "Episode conclusion: DELIVER",
+        body: episodeConclusionBody(conclusion),
+        provenance: `episode:${conclusion.conclusionId}`,
+        relatedRefs: [
+          { kind: "git_commit", id: head },
+          { kind: "journal_entry", id: entries[latestIndex]!.entry.entryId },
+        ],
+        createdAt: recordedAt,
+      });
+      const expectedBasis = await store.basis(projectId);
+      if (expectedBasis === undefined) return Object.freeze({ recorded: false, detail: "the project journal has no basis" });
+      try {
+        await store.appendAtomic({ expectedBasis, events: [journalEntryRecordedEvent(entry)] });
+        return Object.freeze({ recorded: true, detail: `refreshed DELIVER provenance at ${head.slice(0, 12)}`, conclusionId: conclusion.conclusionId });
+      } catch (error) {
+        const message = error instanceof Error ? error.message : String(error);
+        if (!/basis|busy|locked|contention/iu.test(message)) {
+          return Object.freeze({ recorded: false, detail: `journal refresh refused: ${message}` });
+        }
+        // Another writer advanced the journal; re-read and retry the same bounded check.
+      }
+    }
+    return Object.freeze({ recorded: false, detail: "journal refresh did not settle after bounded retries" });
+  } finally {
+    store.close();
+  }
+}
+
+/** Exposed for the oracle: the exact hook script body a host would install. */
+export function directDeliveryHookBodyForTest(nodePath: string, guardScript: string, configPath: string): string {
+  return hookBody(nodePath, guardScript, configPath);
+}
