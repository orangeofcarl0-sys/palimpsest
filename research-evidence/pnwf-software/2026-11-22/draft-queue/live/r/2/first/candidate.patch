diff --git a/test/pnwf_direct_guard.test.ts b/test/pnwf_direct_guard.test.ts
new file mode 100644
index 0000000..4323873
--- /dev/null
+++ b/test/pnwf_direct_guard.test.ts
@@ -0,0 +1,187 @@
+/**
+ * PWRS-D — the direct-delivery guard over the ordinary product path.
+ *
+ * The sealed rejection is a session that merges a prepared review and stops without `conclude`.
+ * This test drives the real product: a principal records DELIVER for review A, a later commit moves
+ * the same artifact to review B, and the guard refreshes only the provenance of the EXISTING
+ * judgement. Empty, unrelated and dirty advances must not add a record. Foreign Git hooks are never
+ * replaced. The test calls the guard entry point directly so it does not depend on the host's hook
+ * execution or on a compiled module URL.
+ */
+import { execFileSync } from "node:child_process";
+import { existsSync, mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { pathToFileURL } from "node:url";
+
+import { afterAll, describe, expect, it } from "vitest";
+
+import { installProduct } from "../src/product.js";
+import {
+  installDirectDeliveryGuard,
+  runDirectDeliveryGuard,
+} from "../src/deployment/direct_delivery_guard.js";
+import type { DshToolDefinition, DshToolRunContext } from "../src/tools/dsh_types.js";
+
+const cleanups: Array<() => void | Promise<void>> = [];
+afterAll(async () => {
+  for (const cleanup of cleanups.reverse()) await cleanup();
+});
+
+const git = (repo: string, ...args: string[]): string =>
+  execFileSync("git", ["-C", repo, ...args], { encoding: "utf8" }).trim();
+const commit = (repo: string, path: string, message: string): string => {
+  git(repo, "add", "--", path);
+  git(repo, "-c", "user.name=Fixture", "-c", "user.email=fixture@example.invalid", "commit", "-qm", message);
+  return git(repo, "rev-parse", "HEAD");
+};
+
+function workspace(name: string): { repo: string; stateDir: string; head: string } {
+  const root = mkdtempSync(join(tmpdir(), `palimpsest-direct-guard-${name}-`));
+  const repo = join(root, "repo");
+  mkdirSync(repo, { recursive: true });
+  writeFileSync(join(repo, "maintenance.md"), "Maintenance basis\n");
+  execFileSync("git", ["init", "-q"], { cwd: repo });
+  git(repo, "config", "user.name", "Fixture");
+  git(repo, "config", "user.email", "fixture@example.invalid");
+  const head = commit(repo, "maintenance.md", "Initial project basis");
+  cleanups.push(() => rmSync(root, { recursive: true, force: true }));
+  return { repo, stateDir: join(root, "state"), head };
+}
+
+async function call(
+  installed: ReturnType<typeof installProduct>,
+  name: string,
+  args: Record<string, unknown>,
+): Promise<Record<string, unknown>> {
+  const definition = installed.tools.find((entry) => entry.name === name) as DshToolDefinition | undefined;
+  if (definition === undefined) throw new Error(`missing tool ${name}`);
+  const context: DshToolRunContext = {
+    callId: `guard-${name}`,
+    rootCallId: `guard-${name}`,
+    arguments: args,
+    name,
+    signal: new AbortController().signal,
+  };
+  return (await definition.execute(args, context)) as Record<string, unknown>;
+}
+
+async function conclusions(installed: ReturnType<typeof installProduct>): Promise<
+  Array<{ entryId: string; conclusion: { intent: string; conclusionId: string; statement: string; check?: { artifacts?: Array<{ path: string; commit?: string | null; digest?: string }> } } }>
+> {
+  const entries = await installed.application.projectWorkspace!.journal();
+  const marker = "<!-- pc1-episode-conclusion:v1 -->";
+  return entries.flatMap(({ entry }) => {
+    const at = entry.body.indexOf(marker);
+    if (at < 0) return [];
+    try {
+      return [{ entryId: entry.entryId, conclusion: JSON.parse(entry.body.slice(at + marker.length).trim()) }];
+    } catch {
+      return [];
+    }
+  });
+}
+
+describe("PWRS-D direct-delivery guard", () => {
+  it("does not replace another tool's hook and removes only its own", () => {
+    const { repo } = workspace("hooks");
+    const hook = join(repo, ".git/hooks/post-commit");
+    mkdirSync(join(repo, ".git/hooks"), { recursive: true });
+    writeFileSync(hook, "#!/bin/sh\necho foreign\n", { mode: 0o755 });
+    const refused = installDirectDeliveryGuard({
+      repository: repo,
+      projectId: "guard-hooks",
+      journalPath: join(repo, "journal.sqlite"),
+      orchestrationPath: join(repo, "palimpsest.sqlite"),
+      moduleUrl: "file:///nonexistent/guard.mjs",
+    });
+    expect(refused.installed).toBe(false);
+    expect(readFileSync(hook, "utf8")).toContain("echo foreign");
+    expect(existsSync(join(repo, ".git/hooks/post-merge"))).toBe(false);
+
+    rmSync(hook);
+    const installed = installDirectDeliveryGuard({
+      repository: repo,
+      projectId: "guard-hooks",
+      journalPath: join(repo, "journal.sqlite"),
+      orchestrationPath: join(repo, "palimpsest.sqlite"),
+      moduleUrl: "file:///nonexistent/guard.mjs",
+    });
+    expect(installed.installed).toBe(true);
+    expect(readFileSync(hook, "utf8")).toContain("palimpsest-direct-delivery-guard");
+    expect(existsSync(join(repo, ".git/hooks/post-merge"))).toBe(true);
+    installed.dispose();
+    expect(existsSync(hook)).toBe(false);
+    expect(existsSync(join(repo, ".git/hooks/post-merge"))).toBe(false);
+  });
+
+  it("refreshes an existing DELIVER after a direct advance and ignores empty, unrelated and dirty advances", async () => {
+    const { repo, stateDir, head: basis } = workspace("refresh");
+    const installed = installProduct(
+      { tools: { register: () => () => undefined } } as never,
+      { projectId: "guard-refresh", repository: repo, stateDir, execution: "in-place", toolProfile: "normal" },
+    );
+    cleanups.push(() => installed.dispose());
+    await call(installed, "palimpsest_start", {
+      projectId: "guard-refresh",
+      goal: "preserve the principal's delivery",
+      headCommit: basis,
+      tasks: [],
+    });
+
+    writeFileSync(join(repo, "MAINTENANCE-REVIEW.md"), "# Review\n\nREADY A\n");
+    const reviewA = commit(repo, "MAINTENANCE-REVIEW.md", "Review A");
+    const first = await call(installed, "palimpsest_work", {
+      action: "conclude",
+      intent: "DELIVER",
+      artifacts: ["MAINTENANCE-REVIEW.md"],
+      statement: "Deliver the revalidated cold-handover review.",
+    });
+    expect(first.state).toBe("RECORDED");
+    expect((await conclusions(installed)).length).toBe(1);
+
+    // Install only the config/hook files; the hook's module URL is deliberately inert, so this test
+    // exercises the guard entry point deterministically after each commit.
+    const guard = installDirectDeliveryGuard({
+      repository: repo,
+      projectId: "guard-refresh",
+      journalPath: join(stateDir, "journal.sqlite"),
+      orchestrationPath: join(stateDir, "palimpsest.sqlite"),
+      moduleUrl: pathToFileURL(join(repo, "inert-guard.mjs")).href,
+    });
+    cleanups.push(() => guard.dispose());
+    const config = join(repo, ".git/palimpsest/direct-delivery.json");
+
+    writeFileSync(join(repo, "MAINTENANCE-REVIEW.md"), "# Review\n\nREADY B\n");
+    const reviewB = commit(repo, "MAINTENANCE-REVIEW.md", "Review B");
+    expect((await runDirectDeliveryGuard(config)).recorded).toBe(true);
+    const afterRefresh = await conclusions(installed);
+    const latest = afterRefresh.filter(({ conclusion }) => conclusion.intent === "DELIVER").at(-1);
+    const artifact = latest?.conclusion.check?.artifacts?.find((state) => state.path === "MAINTENANCE-REVIEW.md");
+    expect(afterRefresh.length).toBe(2);
+    expect(artifact?.commit).toBe(reviewB);
+    expect(latest?.conclusion.statement).toContain("Deliver the revalidated cold-handover review.");
+    expect(latest?.conclusion.statement).toContain("Direct-delivery guard refreshed provenance");
+
+    // An empty commit leaves the bytes unchanged.
+    git(repo, "commit", "-q", "--allow-empty", "-m", "Empty");
+    expect((await runDirectDeliveryGuard(config)).recorded).toBe(false);
+    // An unrelated commit touches no artifact the conclusion named.
+    writeFileSync(join(repo, "maintenance.md"), "Maintenance basis, unrelated\n");
+    commit(repo, "maintenance.md", "Unrelated");
+    expect((await runDirectDeliveryGuard(config)).recorded).toBe(false);
+    // A dirty worktree cannot prove the named bytes are final.
+    writeFileSync(join(repo, "MAINTENANCE-REVIEW.md"), "# Review\n\nREADY C\n");
+    git(repo, "add", "--", "MAINTENANCE-REVIEW.md");
+    writeFileSync(join(repo, "dirty-note.txt"), "not part of the commit\n");
+    git(repo, "-c", "user.name=Fixture", "-c", "user.email=fixture@example.invalid", "commit", "-qm", "Review C with dirty note");
+    expect((await runDirectDeliveryGuard(config)).recorded).toBe(false);
+    expect((await conclusions(installed)).length).toBe(2);
+
+    const status = installed.controller.status();
+    expect(status.headCommit).toBe(basis);
+    expect(status.attempts).toHaveLength(0);
+    expect(status.promotions).toHaveLength(0);
+    expect(reviewA).not.toBe(reviewB);
+  });
+});
