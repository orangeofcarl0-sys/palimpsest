+): DirectDeliveryGuardInstallation {
+  const repository = resolve(input.repository);
+  const gitDir = git(repository, ["rev-parse", "--absolute-git-dir"]);
+  if (gitDir === null) return installDirectDeliveryGuard(input);
+  const hookDir = resolveHookDir(repository);
+  if (hookDir === null) return installDirectDeliveryGuard(input);
+  const moduleUrl = input.moduleUrl ?? moduleUrlForThisFile();
+  const configPath = join(gitDir, "palimpsest", "direct-delivery.json");
+  const guardScript = join(gitDir, "palimpsest", "direct-delivery-guard.mjs");
