+  try {
+    config = JSON.parse(readFileSync(configPath, "utf8")) as Partial<GuardConfig>;
+  } catch {
+    return installDirectDeliveryGuard(input);
+  }
+  const matches =
+    config.schema === DIRECT_DELIVERY_GUARD_SCHEMA &&
+    config.projectId === input.projectId &&
+    config.repository === repository &&
+    config.journalPath === resolve(input.journalPath) &&
