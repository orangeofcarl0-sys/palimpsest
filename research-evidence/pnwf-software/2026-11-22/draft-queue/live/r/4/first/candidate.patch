+++ b/scripts/pnwf/software/self-maintenance-late-guard.mjs
@@ -0,0 +1,254 @@
+/**
+ * Sealed replay of the ordering that still lost the delivery record.
+ *
+ * The earlier sealed guard oracle installed the guard directly into a repository that already
+ * existed. The acceptance probe launches the deployment FIRST and materializes the Git worktree
+ * afterwards, so `installDirectDeliveryGuard` honestly reports "repository is not a readable Git
+ * worktree" and the later `git merge` has no hook. The pulse then repeats the required action, the
+ * fixed executor merges, replies, and the journal still has no record for the merged review.
+ *
+ * This script reproduces that exact ordering against the sealed case-1/case-2 owner databases and
+ * the receipt commits. It launches the real product, creates the worktree afterwards, calls the
+ * real continuity pulse, merges the prepared review, and then inspects the journal. The control arm
+ * skips the pulse, so it must still record nothing: the fix repairs wiring, not the judgement.
+ *
+ * Sealed inputs are intentionally untracked. When they are absent this script reports SKIP.
+ */
+import { execFileSync } from "node:child_process";
+import { createHash } from "node:crypto";
+import { cpSync, existsSync, mkdirSync, mkdtempSync, readFileSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { pathToFileURL } from "node:url";
+import { DatabaseSync } from "node:sqlite";
+
+const here = process.cwd();
+const evidence = join(here, "evidence");
+const inputs = {
+  basis: join(evidence, "basis.bundle"),
+  owners: {
+    WITHOUT: join(evidence, "case-1/owners"),
+    WITH: join(evidence, "case-2/owners"),
+  },
+  candidate: {
+    WITHOUT: join(evidence, "case-1/candidate.bundle"),
+    WITH: join(evidence, "case-2/candidate.bundle"),
+  },
+  receipt: {
+    WITHOUT: join(evidence, "rejection/without/receipt.json"),
+    WITH: join(evidence, "rejection/with/receipt.json"),
+  },
+};
+const missing = Object.entries(inputs)
+  .flatMap(([name, value]) =>
+    typeof value === "string" ? [[name, value]] : Object.entries(value).map(([arm, path]) => [`${name}.${arm}`, path]),
+  )
+  .filter(([, path]) => !existsSync(path));
+if (missing.length > 0) {
+  console.log("LATE_GUARD_SKIP " + JSON.stringify({ missing: missing.map(([name]) => name) }));
+  process.exit(0);
+}
+
+const { loadDeploymentProfile, launchDeployment } = await import(pathToFileURL(join(here, "dist/src/deployment/index.js")));
+const { parseEpisodeConclusion } = await import(pathToFileURL(join(here, "dist/src/project_continuity/episode.js")));
+
+function seed(arm) {
+  const base = mkdtempSync(join(tmpdir(), `late-guard-${arm.toLowerCase()}-`));
+  const repository = join(base, "world");
+  const state = join(base, "state");
+  mkdirSync(repository);
+  cpSync(inputs.owners[arm], state, { recursive: true });
+  const profilePath = join(base, "deployment.json");
+  writeFileSync(
+    profilePath,
+    `${JSON.stringify(
+      {
+        schemaVersion: 1,
+        profileId: `late-guard-${arm.toLowerCase()}`,
+        projectId: "grpc-migration-continuation",
+        localPeer: "late-guard-peer",
+        repository,
+        execution: "worktree",
+        concurrency: 1,
+        toolProfile: "normal",
+        policy: { allowed_commands: [{ executable: "node", argv_prefix: ["--test"] }] },
+        standard: { statement: "The review is committed and the repository is clean." },
+        transport: { namespace: `late-guard-${arm.toLowerCase()}`, databasePath: join(state, "transport.sqlite") },
+        databases: {
+          orchestration: join(state, "palimpsest.sqlite"),
+          ordarium: join(state, "ordarium.sqlite"),
+          coordination: join(state, "coordination.sqlite"),
+          transportCursors: join(state, "transport-cursors.sqlite"),
+          projectJournal: join(state, "journal.sqlite"),
+          projectAssociations: join(state, "associations.sqlite"),
+          management: join(state, "management.sqlite"),
+        },
+      },
+      null,
+      2,
+    )}\n`,
+  );
+  return { base, repository, state, profilePath };
+}
+
+function materialize(seedValue, arm) {
+  const git = (...args) => execFileSync("git", ["-C", seedValue.repository, ...args], { encoding: "utf8" }).trim();
+  git("init", "-q");
+  git("fetch", "-q", inputs.basis, "HEAD:refs/heads/basis");
+  git("fetch", "-q", inputs.candidate[arm], "HEAD:refs/heads/replay");
+  git("checkout", "-q", "-B", "main", "refs/heads/basis");
+  git("config", "user.name", "Late sealed replay");
+  git("config", "user.email", "late@example.invalid");
+  return git;
+}
+
+function conclusions(state) {
+  const db = new DatabaseSync(join(state, "journal.sqlite"));
+  try {
+    const rows = db.prepare("SELECT event_id, payload_json FROM project_journal_events ORDER BY seq").all();
+    const found = [];
+    for (const row of rows) {
+      const payload = JSON.parse(row.payload_json);
+      if (payload.entry === undefined) continue;
+      const conclusion = parseEpisodeConclusion(payload.entry.body);
+      if (conclusion !== null) found.push({ entryId: payload.entry.entryId, conclusion });
+    }
+    return found;
+  } finally {
+    db.close();
+  }
+}
+
+function entries(state) {
+  const db = new DatabaseSync(join(state, "journal.sqlite"));
+  try {
+    const rows = db.prepare("SELECT payload_json FROM project_journal_events ORDER BY seq").all();
+    return rows
+      .map((row) => JSON.parse(row.payload_json).entry)
+      .filter((entry) => entry !== undefined);
+  } finally {
+    db.close();
+  }
+}
+
+function canonical(state) {
+  const db = new DatabaseSync(join(state, "palimpsest.sqlite"));
+  try {
+    return db.prepare("SELECT revision, digest, head_commit FROM projects").get();
+  } finally {
+    db.close();
+  }
+}
+
+async function pulse(deployment) {
+  const tool = deployment.installed.tools.find((entry) => entry.name === "palimpsest_continuity");
+  if (tool === undefined) throw new Error("the deployment exposes no continuity tool");
+  return await tool.execute(
+    { action: "pulse" },
+    { callId: "late-guard-pulse", rootCallId: "late-guard-pulse", arguments: { action: "pulse" }, name: tool.name, signal: new AbortController().signal },
+  );
+}
+
+const checks = {};
+for (const arm of ["WITHOUT", "WITH"]) {
+  const expected = JSON.parse(readFileSync(inputs.receipt[arm], "utf8")).expected;
+  const before = seed(arm);
+  const deployment = launchDeployment(loadDeploymentProfile(before.profilePath));
+  const launchedWithoutHook = !existsSync(join(before.repository, ".git/hooks/post-merge"));
+  const git = materialize(before, arm);
+  const beforeConclusions = conclusions(before.state);
+  const beforeEntries = entries(before.state);
+  const beforeLatest = beforeConclusions.filter(({ conclusion }) => conclusion.intent === "DELIVER").at(-1) ?? null;
+  const beforeLatestIndex = beforeEntries.findIndex((entry) => entry.entryId === beforeLatest?.entryId);
+  const laterNotes = beforeLatestIndex < 0 ? [] : beforeEntries.slice(beforeLatestIndex + 1);
+
+  // The real invocation order: the pulse is the ONLY product call before the fixed executor's merge.
+  const beforePulse = await pulse(deployment);
+  const requiredAction = beforePulse.requiredAction;
+  const hookAfterPulse = existsSync(join(before.repository, ".git/hooks/post-merge"));
+  const configAfterPulse = join(before.repository, ".git/palimpsest/direct-delivery.json");
+  const config = existsSync(configAfterPulse) ? JSON.parse(readFileSync(configAfterPulse, "utf8")) : null;
+
+  git("merge", "--quiet", "--ff-only", "replay");
+  const head = git("rev-parse", "HEAD");
+  const after = conclusions(before.state);
+  const latest = after.filter(({ conclusion }) => conclusion.intent === "DELIVER").at(-1) ?? null;
+  const artifact = latest?.conclusion?.check?.artifacts?.find((state) => state.path === expected.committedArtifact) ?? null;
+  const bytes = execFileSync("git", ["-C", before.repository, "cat-file", "blob", `${expected.commit}:${expected.committedArtifact}`], {
+    maxBuffer: 8 * 1024 * 1024,
+  });
+  const digest = createHash("sha256").update(bytes).digest("hex");
+  const row = canonical(before.state);
+  const priorArtifacts = beforeLatest?.conclusion?.artifacts ?? [];
+  const nowArtifacts = latest?.conclusion?.artifacts ?? [];
+  const afterPulse = await pulse(deployment);
+  const hooksAfterDispose = { postCommitExists: true, postMergeExists: true };
+  await deployment.close();
+  hooksAfterDispose.postCommitExists = existsSync(join(before.repository, ".git/hooks/post-commit"));
+  hooksAfterDispose.postMergeExists = existsSync(join(before.repository, ".git/hooks/post-merge"));
+
+  checks[`${arm}_launch_precedes_worktree`] = launchedWithoutHook;
+  checks[`${arm}_pulse_requires_the_missed_record`] =
+    requiredAction?.kind === "RECORD_DIRECT_DELIVERY" &&
+    requiredAction?.repositoryHead === "1444de6ce289197a1d12b0b04d2caa36c1d79355" &&
+    requiredAction?.artifacts?.includes(expected.committedArtifact);
+  checks[`${arm}_pulse_repairs_wiring`] =
+    hookAfterPulse &&
+    config?.schema === "pc1-direct-delivery-guard/v1" &&
+    config?.repository === before.repository &&
+    config?.journalPath === join(before.state, "journal.sqlite") &&
+    config?.orchestrationPath === join(before.state, "palimpsest.sqlite");
+  checks[`${arm}_head_matches_receipt`] = head === expected.commit;
+  checks[`${arm}_one_delivery_record`] = after.length - beforeConclusions.length === 1;
+  checks[`${arm}_record_names_expected_artifact`] = artifact?.path === expected.committedArtifact;
+  checks[`${arm}_record_commit_and_digest_match`] =
+    artifact?.commit === expected.commit &&
+    artifact?.digest === digest &&
+    artifact?.present === true &&
+    artifact?.tracked === true &&
+    artifact?.committed === true;
+  checks[`${arm}_record_keeps_prior_artifacts`] = priorArtifacts.every((path) => nowArtifacts.includes(path));
+  checks[`${arm}_later_note_is_not_hidden`] = laterNotes.every((entry) =>
+    (latest?.conclusion?.evidenceRefs ?? []).includes(`journal:${entry.entryId}`));
+  checks[`${arm}_principal_statement_preserved`] =
+    typeof latest?.conclusion?.statement === "string" &&
+    typeof beforeLatest?.conclusion?.statement === "string" &&
+    latest.conclusion.statement.includes(beforeLatest.conclusion.statement) &&
+    latest.conclusion.statement.includes("Direct-delivery guard refreshed provenance");
+  checks[`${arm}_next_pulse_reuses_record`] =
+    afterPulse.requiredAction === undefined && afterPulse.episode?.state === "DELIVERED" && afterPulse.episode?.current === true;
+  checks[`${arm}_canonical_basis_unchanged`] =
+    row.head_commit === "95b83e71ee9a37041b9918b5e8b797eebabf69c9" &&
+    row.revision === 2 &&
+    latest?.conclusion?.basis?.headCommit === row.head_commit;
+  checks[`${arm}_dispose_removes_own_hooks`] = !hooksAfterDispose.postCommitExists && !hooksAfterDispose.postMergeExists;
+
+  // CONTROL: same late worktree, but no product read before the merge. Nothing may be recorded.
+  const control = seed(arm);
+  const controlDeployment = launchDeployment(loadDeploymentProfile(control.profilePath));
+  const controlGit = materialize(control, arm);
+  const controlBefore = conclusions(control.state);
+  controlGit("merge", "--quiet", "--ff-only", "replay");
+  const controlAfter = conclusions(control.state);
+  await controlDeployment.close();
+  checks[`${arm}_control_without_pulse_records_nothing`] = controlAfter.length === controlBefore.length;
+
+  console.log(
+    "LATE_GUARD_ARM " +
+      JSON.stringify({
+        arm,
+        expected,
+        beforeHead: "1444de6ce289197a1d12b0b04d2caa36c1d79355",
+        head,
+        beforeConclusions: beforeConclusions.length,
+        afterConclusions: after.length,
+        requiredAction: requiredAction ?? null,
+        hookAfterPulse,
+        artifact,
+        expectedDigest: digest,
+      }),
+  );
+}
+
+console.log("LATE_GUARD " + JSON.stringify({ checks }));
+process.exitCode = Object.values(checks).every(Boolean) ? 0 : 1;
