index 0000000..63c4f48
--- /dev/null
+++ b/scripts/pnwf/software/self-maintenance-prepared-ref.mjs
@@ -0,0 +1,265 @@
+/**
+ * Sealed replay of the prepared-review shape that the fixed executor actually receives.
+ *
+ * The acceptance probe does not promise that the prepared candidate is a LOCAL BRANCH. A bundle
+ * carries only HEAD, so a probe may expose it as a tag or a bare commit and still run the ordinary
+ * `git merge --ff-only replay`. The earlier guard recognised only "HEAD is also the tip of another
+ * local branch"; with a tag or a bare commit it refused to name the review path that the merge had
+ * just added, and the journal kept no delivery record.
+ *
+ * This oracle replays the sealed case-1/case-2 owner databases and receipt commits with the
+ * prepared review exposed three ways (branch, tag, bare commit), plus a control that adds a new
+ * path by an ordinary current-branch commit. It launches the real deployment, calls the real
+ * continuity pulse, runs the same fast-forward merge as the fixed executor, and inspects the
+ * journal. It fails on a guard that only checks local branch tips: on 2ba8c7f it exits 1 with the
+ * tag and bare-commit arms recording nothing (24 false checks), while the branch arm passes.
+ *
+ * Sealed inputs are intentionally untracked. When they are absent this script reports SKIP.
+ */
+import { execFileSync } from "node:child_process";
+import { createHash } from "node:crypto";
+import { cpSync, existsSync, mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { pathToFileURL } from "node:url";
+import { DatabaseSync } from "node:sqlite";
+
+const here = process.cwd();
+const evidence = join(here, "evidence");
+const inputs = {
+  basis: join(evidence, "basis.bundle"),
+  owners: {
+    WITHOUT: join(evidence, "case-1/owners"),
+    WITH: join(evidence, "case-2/owners"),
+  },
+  candidate: {
+    WITHOUT: join(evidence, "case-1/candidate.bundle"),
+    WITH: join(evidence, "case-2/candidate.bundle"),
+  },
+  receipt: {
+    WITHOUT: join(evidence, "rejection/without/receipt.json"),
+    WITH: join(evidence, "rejection/with/receipt.json"),
+  },
+};
+const missing = Object.entries(inputs)
+  .flatMap(([name, value]) =>
+    typeof value === "string" ? [[name, value]] : Object.entries(value).map(([arm, path]) => [`${name}.${arm}`, path]),
+  )
+  .filter(([, path]) => !existsSync(path));
+if (missing.length > 0) {
+  console.log("PREPARED_REF_SKIP " + JSON.stringify({ missing: missing.map(([name]) => name) }));
+  process.exit(0);
+}
+
+const { loadDeploymentProfile, launchDeployment } = await import(pathToFileURL(join(here, "dist/src/deployment/index.js")));
+const { parseEpisodeConclusion } = await import(pathToFileURL(join(here, "dist/src/project_continuity/episode.js")));
+
+function seed(arm, label) {
+  const base = mkdtempSync(join(tmpdir(), `prepared-ref-${arm.toLowerCase()}-${label}-`));
+  const repository = join(base, "world");
+  const state = join(base, "state");
+  mkdirSync(repository);
+  cpSync(inputs.owners[arm], state, { recursive: true });
+  const profilePath = join(base, "deployment.json");
+  writeFileSync(
+    profilePath,
+    `${JSON.stringify(
+      {
+        schemaVersion: 1,
+        profileId: `prepared-ref-${arm.toLowerCase()}-${label}`,
+        projectId: "grpc-migration-continuation",
+        localPeer: "prepared-ref-peer",
+        repository,
+        execution: "worktree",
+        concurrency: 1,
+        toolProfile: "normal",
+        policy: { allowed_commands: [{ executable: "node", argv_prefix: ["--test"] }] },
+        standard: { statement: "The review is committed and the repository is clean." },
+        transport: { namespace: `prepared-ref-${arm.toLowerCase()}-${label}`, databasePath: join(state, "transport.sqlite") },
+        databases: {
+          orchestration: join(state, "palimpsest.sqlite"),
+          ordarium: join(state, "ordarium.sqlite"),
+          coordination: join(state, "coordination.sqlite"),
+          transportCursors: join(state, "transport-cursors.sqlite"),
+          projectJournal: join(state, "journal.sqlite"),
+          projectAssociations: join(state, "associations.sqlite"),
+          management: join(state, "management.sqlite"),
+        },
+      },
+      null,
+      2,
+    )}\n`,
+  );
+  return { base, repository, state, profilePath };
+}
+
+function materialize(seedValue, arm) {
+  const git = (...args) => execFileSync("git", ["-C", seedValue.repository, ...args], { encoding: "utf8" }).trim();
+  git("init", "-q");
+  git("fetch", "-q", inputs.basis, "HEAD:refs/heads/basis");
+  git("fetch", "-q", inputs.candidate[arm], "HEAD");
+  const candidate = git("rev-parse", "FETCH_HEAD");
+  git("checkout", "-q", "-B", "main", "refs/heads/basis");
+  git("config", "user.name", "Prepared-ref sealed replay");
+  git("config", "user.email", "prepared-ref@example.invalid");
+  return { git, candidate };
+}
+
+function conclusions(state) {
+  const db = new DatabaseSync(join(state, "journal.sqlite"));
+  try {
+    const rows = db.prepare("SELECT payload_json FROM project_journal_events ORDER BY seq").all();
+    const found = [];
+    for (const row of rows) {
+      const payload = JSON.parse(row.payload_json);
+      if (payload.entry === undefined) continue;
+      const conclusion = parseEpisodeConclusion(payload.entry.body);
+      if (conclusion !== null) found.push({ entryId: payload.entry.entryId, conclusion });
+    }
+    return found;
+  } finally {
+    db.close();
+  }
+}
+
+function canonical(state) {
+  const db = new DatabaseSync(join(state, "palimpsest.sqlite"));
+  try {
+    return db.prepare("SELECT revision, digest, head_commit FROM projects").get();
+  } finally {
+    db.close();
+  }
+}
+
+async function pulse(deployment) {
+  const tool = deployment.installed.tools.find((entry) => entry.name === "palimpsest_continuity");
+  if (tool === undefined) throw new Error("the deployment exposes no continuity tool");
+  return await tool.execute(
+    { action: "pulse" },
+    { callId: "prepared-ref-pulse", rootCallId: "prepared-ref-pulse", arguments: { action: "pulse" }, name: tool.name, signal: new AbortController().signal },
+  );
+}
+
+const checks = {};
+const KINDS = ["branch", "tag", "commit"];
+for (const arm of ["WITHOUT", "WITH"]) {
+  const expected = JSON.parse(readFileSync(inputs.receipt[arm], "utf8")).expected;
+  for (const kind of KINDS) {
+    const before = seed(arm, kind);
+    const deployment = launchDeployment(loadDeploymentProfile(before.profilePath));
+    const { git, candidate } = materialize(before, arm);
+    const beforeConclusions = conclusions(before.state);
+    const beforeLatest = beforeConclusions.filter(({ conclusion }) => conclusion.intent === "DELIVER").at(-1) ?? null;
+    const beforeHead = git("rev-parse", "HEAD");
+
+    const beforePulse = await pulse(deployment);
+    const requiredAction = beforePulse.requiredAction;
+    let mergeTarget = candidate;
+    if (kind === "branch") {
+      git("branch", "replay", candidate);
+      mergeTarget = "replay";
+    } else if (kind === "tag") {
+      git("tag", "replay", candidate);
+      mergeTarget = "replay";
+    }
+    git("merge", "--quiet", "--ff-only", mergeTarget);
+    const head = git("rev-parse", "HEAD");
+    const after = conclusions(before.state);
+    const latest = after.filter(({ conclusion }) => conclusion.intent === "DELIVER").at(-1) ?? null;
+    const artifact = latest?.conclusion?.check?.artifacts?.find((state) => state.path === expected.committedArtifact) ?? null;
+    const bytes = execFileSync("git", ["-C", before.repository, "cat-file", "blob", `${expected.commit}:${expected.committedArtifact}`], {
+      maxBuffer: 8 * 1024 * 1024,
+    });
+    const digest = createHash("sha256").update(bytes).digest("hex");
+    const row = canonical(before.state);
+    const priorArtifacts = beforeLatest?.conclusion?.artifacts ?? [];
+    const nowArtifacts = latest?.conclusion?.artifacts ?? [];
+    const afterPulse = await pulse(deployment);
+    await deployment.close();
+
+    checks[`${arm}_${kind}_candidate_is_not_a_local_branch`] = kind === "branch" || !git("branch", "--list", "replay");
+    checks[`${arm}_${kind}_pulse_requires_the_missed_record`] =
+      requiredAction?.kind === "RECORD_DIRECT_DELIVERY" &&
+      requiredAction?.artifacts?.includes(expected.committedArtifact);
+    checks[`${arm}_${kind}_head_is_the_prepared_candidate`] = beforeHead !== head && head === expected.commit;
+    checks[`${arm}_${kind}_one_delivery_record`] = after.length - beforeConclusions.length === 1;
+    checks[`${arm}_${kind}_record_names_expected_artifact`] = artifact?.path === expected.committedArtifact;
+    checks[`${arm}_${kind}_record_commit_and_digest_match`] =
+      artifact?.commit === expected.commit &&
+      artifact?.digest === digest &&
+      artifact?.present === true &&
+      artifact?.tracked === true &&
+      artifact?.committed === true;
+    checks[`${arm}_${kind}_record_keeps_prior_artifacts`] = priorArtifacts.every((path) => nowArtifacts.includes(path));
+    checks[`${arm}_${kind}_principal_statement_preserved`] =
+      typeof latest?.conclusion?.statement === "string" &&
+      typeof beforeLatest?.conclusion?.statement === "string" &&
+      latest.conclusion.statement.includes(beforeLatest.conclusion.statement) &&
+      latest.conclusion.statement.includes("Direct-delivery guard refreshed provenance");
+    checks[`${arm}_${kind}_next_pulse_reuses_record`] =
+      afterPulse.requiredAction === undefined && afterPulse.episode?.state === "DELIVERED" && afterPulse.episode?.current === true;
+    checks[`${arm}_${kind}_canonical_basis_unchanged`] =
+      row.head_commit === "95b83e71ee9a37041b9918b5e8b797eebabf69c9" &&
+      row.revision === 2 && latest?.conclusion?.basis?.headCommit === row.head_commit;
+
+    // CONTROL: an ordinary current-branch commit that adds a new path is not a prepared advance.
+    const control = seed(arm, `${kind}-control`);
+    const controlDeployment = launchDeployment(loadDeploymentProfile(control.profilePath));
+    const controlMaterialized = materialize(control, arm);
+    const controlBefore = conclusions(control.state);
+    await pulse(controlDeployment);
+    writeFileSync(join(control.repository, "ORDINARY-NOTE.md"), "not a prepared review\n");
+    controlMaterialized.git("add", "--", "ORDINARY-NOTE.md");
+    controlMaterialized.git("commit", "-qm", "Ordinary note on the current branch");
+    const controlAfter = conclusions(control.state);
+    await controlDeployment.close();
+    checks[`${arm}_${kind}_ordinary_commit_records_nothing`] = controlAfter.length === controlBefore.length;
+  }
+
+  // THE SANDBOX CASE: the hook is installed but cannot write the journal, because the agent's Bash
+  // tool runs it inside the workspace sandbox while the journal lives outside that workspace. The
+  // in-process observer must make the same bounded refresh once HEAD moves.
+  const watched = seed(arm, "watcher");
+  const watchedDeployment = launchDeployment(loadDeploymentProfile(watched.profilePath));
+  const watchedGit = materialize(watched, arm);
+  const watchedBefore = conclusions(watched.state);
+  await pulse(watchedDeployment);
+  rmSync(join(watched.repository, ".git/hooks/post-commit"), { force: true });
+  rmSync(join(watched.repository, ".git/hooks/post-merge"), { force: true });
+  watchedGit.git("tag", "replay", watchedGit.candidate);
+  watchedGit.git("merge", "--quiet", "--ff-only", "replay");
+  const watchedHead = watchedGit.git("rev-parse", "HEAD");
+  await new Promise((resolve) => setTimeout(resolve, 1500));
+  const watchedAfter = conclusions(watched.state);
+  const watchedLatest = watchedAfter.filter(({ conclusion }) => conclusion.intent === "DELIVER").at(-1) ?? null;
+  const watchedArtifact = watchedLatest?.conclusion?.check?.artifacts?.find((state) => state.path === expected.committedArtifact) ?? null;
+  const watchedBytes = execFileSync("git", ["-C", watched.repository, "cat-file", "blob", `${expected.commit}:${expected.committedArtifact}`], {
+    maxBuffer: 8 * 1024 * 1024,
+  });
+  const watchedDigest = createHash("sha256").update(watchedBytes).digest("hex");
+  await watchedDeployment.close();
+  checks[`${arm}_watcher_records_when_the_hook_cannot`] = watchedHead === expected.commit && watchedAfter.length - watchedBefore.length === 1;
+  checks[`${arm}_watcher_record_matches_the_commit`] =
+    watchedArtifact?.path === expected.committedArtifact &&
+    watchedArtifact?.commit === expected.commit &&
+    watchedArtifact?.digest === watchedDigest;
+
+  // The observer must not turn an ordinary current-branch commit into a delivery.
+  const watchedControl = seed(arm, "watcher-control");
+  const watchedControlDeployment = launchDeployment(loadDeploymentProfile(watchedControl.profilePath));
+  const watchedControlGit = materialize(watchedControl, arm);
+  const watchedControlBefore = conclusions(watchedControl.state);
+  await pulse(watchedControlDeployment);
+  rmSync(join(watchedControl.repository, ".git/hooks/post-commit"), { force: true });
+  rmSync(join(watchedControl.repository, ".git/hooks/post-merge"), { force: true });
+  writeFileSync(join(watchedControl.repository, "ORDINARY-NOTE.md"), "not a prepared review\n");
+  watchedControlGit.git("add", "--", "ORDINARY-NOTE.md");
+  watchedControlGit.git("commit", "-qm", "Ordinary note observed without a hook");
+  await new Promise((resolve) => setTimeout(resolve, 1000));
+  const watchedControlAfter = conclusions(watchedControl.state);
+  await watchedControlDeployment.close();
+  checks[`${arm}_watcher_does_not_record_an_ordinary_commit`] = watchedControlAfter.length === watchedControlBefore.length;
+}
+
+console.log("PREPARED_REF " + JSON.stringify({ checks }));
+process.exitCode = Object.values(checks).every(Boolean) ? 0 : 1;
