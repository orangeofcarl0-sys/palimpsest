+/**
+ * Sealed replay of the NEXT WORKER's view after a direct delivery.
+ *
+ * The rejection at 8b298c0 shows the guard now records the delivery (`delivered: true`), but the
+ * observation still reports no delivery record (`recorded: []`). Reproducing the ordinary next
+ * session against the sealed case-1/case-2 owners exposes the gap in the normal Work entry:
+ * `palimpsest_work action=readiness` says "reply using the recorded conclusion" while its
+ * `artifacts` list is empty. The direct advance's changed path and the recorded conclusion's
+ * artifacts are only visible in the continuity pulse, so a next session that follows readiness
+ * cannot name what was delivered.
+ *
+ * This oracle replays the sealed owners and candidate commits, calls the real pulse, removes the
+ * Git hooks (the acceptance's Bash tool cannot write the journal), merges the prepared review, and
+ * then reads readiness as the next session would. It requires the readiness to name exactly the new
+ * review path, while the recorded episode conclusion keeps all prior artifacts.
+ *
+ * Sealed inputs are intentionally untracked. When they are absent this script reports SKIP.
+ */
+import { execFileSync } from "node:child_process";
+import { cpSync, existsSync, mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { DatabaseSync } from "node:sqlite";
+import { pathToFileURL } from "node:url";
+
+const here = process.cwd();
+const evidence = join(here, "evidence");
+const inputs = {
+  basis: join(evidence, "basis.bundle"),
+  owners: {
+    WITHOUT: join(evidence, "case-1/owners"),
+    WITH: join(evidence, "case-2/owners"),
+  },
+  candidate: {
+    WITHOUT: join(evidence, "case-1/candidate.bundle"),
+    WITH: join(evidence, "case-2/candidate.bundle"),
+  },
+  receipt: {
+    WITHOUT: join(evidence, "rejection/without/receipt.json"),
+    WITH: join(evidence, "rejection/with/receipt.json"),
+  },
+};
+const missing = Object.entries(inputs)
+  .flatMap(([name, value]) =>
+    typeof value === "string" ? [[name, value]] : Object.entries(value).map(([arm, path]) => [`${name}.${arm}`, path]),
+  )
+  .filter(([, path]) => !existsSync(path));
+if (missing.length > 0) {
+  console.log("READINESS_DELIVERY_SKIP " + JSON.stringify({ missing: missing.map(([name]) => name) }));
+  process.exit(0);
+}
+
+const { loadDeploymentProfile, launchDeployment } = await import(pathToFileURL(join(here, "dist/src/deployment/index.js")));
+
+function seed(arm, label) {
+  const base = mkdtempSync(join(tmpdir(), `readiness-delivery-${arm.toLowerCase()}-${label}-`));
+  const repository = join(base, "world");
+  const state = join(base, "state");
+  mkdirSync(repository);
+  cpSync(inputs.owners[arm], state, { recursive: true });
+  const profilePath = join(base, "deployment.json");
+  writeFileSync(
+    profilePath,
+    `${JSON.stringify(
+      {
+        schemaVersion: 1,
+        profileId: `readiness-delivery-${arm.toLowerCase()}-${label}`,
+        projectId: "grpc-migration-continuation",
+        localPeer: "readiness-delivery-peer",
+        repository,
+        execution: "worktree",
+        concurrency: 1,
+        toolProfile: "normal",
+        policy: { allowed_commands: [{ executable: "node", argv_prefix: ["--test"] }] },
+        standard: { statement: "The review is committed and the repository is clean." },
+        transport: { namespace: `readiness-delivery-${arm.toLowerCase()}-${label}`, databasePath: join(state, "transport.sqlite") },
+        databases: {
+          orchestration: join(state, "palimpsest.sqlite"),
+          ordarium: join(state, "ordarium.sqlite"),
+          coordination: join(state, "coordination.sqlite"),
+          transportCursors: join(state, "transport-cursors.sqlite"),
+          projectJournal: join(state, "journal.sqlite"),
+          projectAssociations: join(state, "associations.sqlite"),
+          management: join(state, "management.sqlite"),
+        },
+      },
+      null,
+      2,
+    )}\n`,
+  );
+  return { base, repository, state, profilePath };
+}
+
+function materialize(seedValue, arm) {
+  const git = (...args) => execFileSync("git", ["-C", seedValue.repository, ...args], { encoding: "utf8" }).trim();
+  git("init", "-q");
+  git("fetch", "-q", inputs.basis, "HEAD:refs/heads/basis");
+  git("fetch", "-q", inputs.candidate[arm], "HEAD:refs/heads/replay");
+  git("checkout", "-q", "-B", "main", "refs/heads/basis");
+  git("config", "user.name", "Readiness sealed replay");
+  git("config", "user.email", "readiness@example.invalid");
+  return git;
+}
+
+async function call(deployment, name, args) {
+  const tool = deployment.installed.tools.find((entry) => entry.name === name);
+  if (tool === undefined) throw new Error(`the deployment exposes no ${name} tool`);
+  return await tool.execute(args, {
+    callId: `readiness-${name}`,
+    rootCallId: `readiness-${name}`,
+    arguments: args,
+    name: tool.name,
+    signal: new AbortController().signal,
+  });
+}
+
+const checks = {};
+for (const arm of ["WITHOUT", "WITH"]) {
+  const expected = JSON.parse(readFileSync(inputs.receipt[arm], "utf8")).expected;
+  const before = seed(arm, "next-worker");
+  const deployment = launchDeployment(loadDeploymentProfile(before.profilePath));
+  const git = materialize(before, arm);
+
+  await call(deployment, "palimpsest_continuity", { action: "pulse" });
+  // The acceptance's Bash tool runs inside the workspace sandbox while the journal is outside it.
+  // Removing the hooks leaves only the product-process observer, which is the mechanism that made
+  // the latest rejection report delivered:true.
+  rmSync(join(before.repository, ".git/hooks/post-commit"), { force: true });
+  rmSync(join(before.repository, ".git/hooks/post-merge"), { force: true });
+  git("merge", "--quiet", "--ff-only", "replay");
+  const head = git("rev-parse", "HEAD");
+
+  // Let the bounded observer record the merge in the product process.
+  await new Promise((resolve) => setTimeout(resolve, 1500));
+
+  const pulse = await call(deployment, "palimpsest_continuity", { action: "pulse" });
+  const readiness = await call(deployment, "palimpsest_work", { action: "readiness" });
+  const control = seed(arm, "no-pulse");
+  const controlDeployment = launchDeployment(loadDeploymentProfile(control.profilePath));
+  const controlGit = materialize(control, arm);
+  const controlReadiness = await call(controlDeployment, "palimpsest_work", { action: "readiness" });
+  await controlDeployment.close();
+
+  const conclusion = pulse.episode?.conclusion ?? null;
+  const conclusionPaths = (conclusion?.check?.artifacts ?? []).map((artifact) => artifact.path);
+  const conclusionAtHead = (conclusion?.check?.artifacts ?? []).filter((artifact) => artifact.commit === expected.commit);
+  const readinessPaths = (readiness.artifacts ?? []).map((artifact) => artifact.path);
+  const deliveryPaths = (readiness.delivery?.artifacts ?? []).map((artifact) => artifact.path);
+  const canonical = (() => {
+    const db = new DatabaseSync(join(before.state, "palimpsest.sqlite"));
+    try {
+      return db.prepare("SELECT revision, head_commit FROM projects").get();
+    } finally {
+      db.close();
+    }
+  })();
+
+  checks[`${arm}_head_matches_receipt`] = head === expected.commit;
+  checks[`${arm}_pulse_has_current_delivery`] =
+    pulse.requiredAction === undefined && pulse.episode?.state === "DELIVERED" && pulse.episode?.current === true;
+  checks[`${arm}_readiness_names_the_direct_advance`] =
+    readiness.action === "SEMANTIC_JUDGEMENT" &&
+    JSON.stringify(readiness.next) === JSON.stringify(["reply using the recorded conclusion"]) &&
+    readinessPaths.length === 1 &&
+    readinessPaths[0] === expected.committedArtifact;
+  checks[`${arm}_readiness_artifact_is_present_and_committed`] =
+    (readiness.artifacts ?? []).every((artifact) => artifact.present === true && artifact.committed === true);
+  checks[`${arm}_readiness_projects_the_recorded_delivery`] =
+    readiness.delivery?.intent === "DELIVER" &&
+    readiness.delivery?.conclusionId === conclusion?.conclusionId &&
+    readiness.delivery?.basisHeadCommit === canonical.head_commit &&
+    JSON.stringify(deliveryPaths) === JSON.stringify([expected.committedArtifact]);
+  checks[`${arm}_conclusion_keeps_prior_artifacts`] =
+    conclusionPaths.length === 5 &&
+    conclusionAtHead.length === 5 &&
+    conclusionPaths.includes(expected.committedArtifact);
+  checks[`${arm}_readiness_reason_names_the_review`] =
+    (readiness.reasons ?? []).some((reason) => typeof reason === "string" && reason.includes(expected.committedArtifact));
+  checks[`${arm}_canonical_basis_unchanged`] =
+    canonical.revision === 2 && canonical.head_commit === "95b83e71ee9a37041b9918b5e8b797eebabf69c9";
+  checks[`${arm}_control_without_a_record_has_no_delivery`] =
+    (controlReadiness.delivery ?? null) === null;
+
+  console.log(
+    "READINESS_DELIVERY_ARM " +
+      JSON.stringify({
+        arm,
+        expected,
+        head,
+        conclusionId: conclusion?.conclusionId ?? null,
+        conclusionPaths,
+        readiness: {
+          action: readiness.action,
+          next: readiness.next,
+          artifacts: readiness.artifacts,
+          delivery: readiness.delivery,
+          reasons: readiness.reasons,
+        },
+      }),
+  );
+  await deployment.close();
+  rmSync(control.repository, { recursive: true, force: true });
+  rmSync(before.repository, { recursive: true, force: true });
+}
+
+console.log("READINESS_DELIVERY " + JSON.stringify({ checks }));
+process.exitCode = Object.values(checks).every(Boolean) ? 0 : 1;
