+++ b/scripts/pnwf/software/self-maintenance-delivery-record.mjs
@@ -0,0 +1,250 @@
+/**
+ * Sealed replay of the acceptance's "delivered but not recorded" observation.
+ *
+ * The independent rejection at 77acf02 reported `delivered: true, recorded: []` even though the
+ * direct-delivery guard had appended a DELIVER conclusion. The guard's record differed from a
+ * principal `conclude` in two ways that a delivery-record consumer can see:
+ *
+ *   - every artifact was re-dated to the new head and given a non-canonical `detail`,
+ *   - the principal's statement was rewritten with a guard suffix.
+ *
+ * This oracle replays the exact sealed owners and prepared-review commits, then applies the same
+ * delivery-record read a consumer performs: one artifact at the expected commit, present, tracked,
+ * committed, with the canonical `detail`, reached from the principal's unchanged statement. It also
+ * checks that the refresh names itself explicitly instead of hiding in the statement.
+ *
+ * Sealed inputs are intentionally untracked. When they are absent this script reports SKIP.
+ */
+import { execFileSync } from "node:child_process";
+import { createHash } from "node:crypto";
+import { cpSync, existsSync, mkdirSync, mkdtempSync, readFileSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { pathToFileURL } from "node:url";
+import { DatabaseSync } from "node:sqlite";
+
+const here = process.cwd();
+const evidence = join(here, "evidence");
+const inputs = {
+  basis: join(evidence, "basis.bundle"),
+  owners: {
+    WITHOUT: join(evidence, "case-1/owners"),
+    WITH: join(evidence, "case-2/owners"),
+  },
+  candidate: {
+    WITHOUT: join(evidence, "case-1/candidate.bundle"),
+    WITH: join(evidence, "case-2/candidate.bundle"),
+  },
+  receipt: {
+    WITHOUT: join(evidence, "rejection/without/receipt.json"),
+    WITH: join(evidence, "rejection/with/receipt.json"),
+  },
+};
+const missing = Object.entries(inputs)
+  .flatMap(([name, value]) =>
+    typeof value === "string" ? [[name, value]] : Object.entries(value).map(([arm, path]) => [`${name}.${arm}`, path]),
+  )
+  .filter(([, path]) => !existsSync(path));
+if (missing.length > 0) {
+  console.log("DELIVERY_RECORD_SKIP " + JSON.stringify({ missing: missing.map(([name]) => name) }));
+  process.exit(0);
+}
+
+const { loadDeploymentProfile, launchDeployment } = await import(pathToFileURL(join(here, "dist/src/deployment/index.js")));
+const { parseEpisodeConclusion } = await import(pathToFileURL(join(here, "dist/src/project_continuity/episode.js")));
+
+function seed(arm) {
+  const base = mkdtempSync(join(tmpdir(), `delivery-record-${arm.toLowerCase()}-`));
+  const repository = join(base, "world");
+  const state = join(base, "state");
+  mkdirSync(repository);
+  cpSync(inputs.owners[arm], state, { recursive: true });
+  const profilePath = join(base, "deployment.json");
+  writeFileSync(
+    profilePath,
+    `${JSON.stringify(
+      {
+        schemaVersion: 1,
+        profileId: `delivery-record-${arm.toLowerCase()}`,
+        projectId: "grpc-migration-continuation",
+        localPeer: "delivery-record-peer",
+        repository,
+        execution: "worktree",
+        concurrency: 1,
+        toolProfile: "normal",
+        policy: { allowed_commands: [{ executable: "node", argv_prefix: ["--test"] }] },
+        standard: { statement: "The review is committed and the repository is clean." },
+        transport: { namespace: `delivery-record-${arm.toLowerCase()}`, databasePath: join(state, "transport.sqlite") },
+        databases: {
+          orchestration: join(state, "palimpsest.sqlite"),
+          ordarium: join(state, "ordarium.sqlite"),
+          coordination: join(state, "coordination.sqlite"),
+          transportCursors: join(state, "transport-cursors.sqlite"),
+          projectJournal: join(state, "journal.sqlite"),
+          projectAssociations: join(state, "associations.sqlite"),
+          management: join(state, "management.sqlite"),
+        },
+      },
+      null,
+      2,
+    )}\n`,
+  );
+  return { base, repository, state, profilePath };
+}
+
+function materialize(seedValue, arm) {
+  const git = (...args) => execFileSync("git", ["-C", seedValue.repository, ...args], { encoding: "utf8" }).trim();
+  git("init", "-q");
+  git("fetch", "-q", inputs.basis, "HEAD:refs/heads/basis");
+  git("fetch", "-q", inputs.candidate[arm], "HEAD:refs/heads/replay");
+  git("checkout", "-q", "-B", "main", "refs/heads/basis");
+  git("config", "user.name", "Delivery record sealed replay");
+  git("config", "user.email", "delivery-record@example.invalid");
+  return git;
+}
+
+function latestConclusion(state) {
+  const db = new DatabaseSync(join(state, "journal.sqlite"));
+  try {
+    const rows = db.prepare("SELECT payload_json FROM project_journal_events ORDER BY seq DESC").all();
+    for (const row of rows) {
+      const payload = JSON.parse(row.payload_json);
+      if (payload.entry === undefined) continue;
+      const conclusion = parseEpisodeConclusion(payload.entry.body);
+      if (conclusion !== null) return conclusion;
+    }
+    return null;
+  } finally {
+    db.close();
+  }
+}
+
+function canonical(state) {
+  const db = new DatabaseSync(join(state, "palimpsest.sqlite"));
+  try {
+    return db.prepare("SELECT revision, digest, head_commit FROM projects").get();
+  } finally {
+    db.close();
+  }
+}
+
+async function pulse(deployment) {
+  const tool = deployment.installed.tools.find((entry) => entry.name === "palimpsest_continuity");
+  if (tool === undefined) throw new Error("the deployment exposes no continuity tool");
+  return await tool.execute(
+    { action: "pulse" },
+    { callId: "delivery-record-pulse", rootCallId: "delivery-record-pulse", arguments: { action: "pulse" }, name: tool.name, signal: new AbortController().signal },
+  );
+}
+
+/**
+ * The exact consumer shape the rejection exposed: a delivery is recorded only when the expected
+ * artifact is present at the expected commit with the product's canonical artifact detail, and the
+ * conclusion still carries the principal's statement verbatim.
+ */
+function deliveryRecords(conclusion, expected, principalStatement) {
+  if (conclusion === null) return [];
+  if (principalStatement !== undefined && conclusion.statement !== principalStatement) return [];
+  return (conclusion.check.artifacts ?? [])
+    .filter(
+      (artifact) =>
+        artifact.path === expected.committedArtifact &&
+        artifact.commit === expected.commit &&
+        artifact.present === true &&
+        artifact.tracked === true &&
+        artifact.committed === true &&
+        artifact.detail === "committed at HEAD",
+    )
+    .map((artifact) => artifact.path);
+}
+
+const checks = {};
+for (const arm of ["WITHOUT", "WITH"]) {
+  const expected = JSON.parse(readFileSync(inputs.receipt[arm], "utf8")).expected;
+  const before = seed(arm);
+  // The acceptance launches the deployment before the world is necessarily a worktree.
+  const deployment = launchDeployment(loadDeploymentProfile(before.profilePath));
+  const git = materialize(before, arm);
+  const beforeLatest = latestConclusion(before.state);
+  const beforeStatement = beforeLatest?.statement;
+  const beforeRecorded = deliveryRecords(beforeLatest, expected, undefined);
+
+  const beforePulse = await pulse(deployment);
+  git("merge", "--quiet", "--ff-only", "replay");
+  const head = git("rev-parse", "HEAD");
+  const latest = latestConclusion(before.state);
+  const recorded = deliveryRecords(latest, expected, beforeStatement);
+  const artifact = latest?.check?.artifacts?.find((state) => state.path === expected.committedArtifact) ?? null;
+  const bytes = execFileSync("git", ["-C", before.repository, "cat-file", "blob", `${expected.commit}:${expected.committedArtifact}`], {
+    maxBuffer: 8 * 1024 * 1024,
+  });
+  const digest = createHash("sha256").update(bytes).digest("hex");
+  const row = canonical(before.state);
+  const priorStates = beforeLatest?.check?.artifacts ?? [];
+  const afterStates = latest?.check?.artifacts ?? [];
+  const atExpectedHead = afterStates.filter((state) => state.commit === expected.commit);
+  const canonicalDetails = afterStates.filter((state) => state.detail === "committed at HEAD");
+  const priorPathsStillPresent = priorStates.every((state) => afterStates.some((after) => after.path === state.path));
+  const priorCommitsCarried = priorStates
+    .filter((state) => state.path !== expected.committedArtifact)
+    .every((state) => afterStates.find((after) => after.path === state.path)?.commit === state.commit);
+  const refresh = latest?.check?.refresh ?? null;
+  await deployment.close();
+
+  checks[`${arm}_before_merge_has_no_delivery_record`] = beforeRecorded.length === 0;
+  checks[`${arm}_pulse_exposes_the_direct_advance`] =
+    beforePulse.requiredAction?.kind === "RECORD_DIRECT_DELIVERY" &&
+    beforePulse.requiredAction?.artifacts?.includes(expected.committedArtifact);
+  checks[`${arm}_head_matches_receipt`] = head === expected.commit;
+  checks[`${arm}_artifact_digest_matches_receipt`] = artifact?.digest === digest;
+  checks[`${arm}_one_recorded_delivery`] =
+    recorded.length === 1 && recorded[0] === expected.committedArtifact;
+  checks[`${arm}_exactly_one_artifact_at_the_new_head`] =
+    atExpectedHead.length === 1 && atExpectedHead[0]?.path === expected.committedArtifact;
+  checks[`${arm}_only_the_new_delivery_has_canonical_detail`] =
+    canonicalDetails.length === 1 && canonicalDetails[0]?.path === expected.committedArtifact;
+  checks[`${arm}_delivered_is_true`] =
+    latest?.intent === "DELIVER" &&
+    (latest.check.artifacts ?? []).some(
+      (state) => state.path === expected.committedArtifact && state.commit === expected.commit && state.committed === true,
+    );
+  checks[`${arm}_artifact_detail_is_canonical`] = artifact?.detail === "committed at HEAD";
+  checks[`${arm}_principal_statement_is_verbatim`] =
+    typeof latest?.statement === "string" &&
+    typeof beforeStatement === "string" &&
+    latest.statement === beforeStatement;
+  checks[`${arm}_refresh_is_explicit`] =
+    refresh?.kind === "DIRECT_DELIVERY_GUARD" &&
+    refresh?.head === expected.commit &&
+    refresh?.fromConclusionId === beforeLatest?.conclusionId &&
+    refresh?.changedPaths?.includes(expected.committedArtifact) &&
+    latest?.evidenceRefs?.includes(`guard:direct-delivery@${expected.commit}`) === true;
+  checks[`${arm}_earlier_artifacts_are_carried`] = priorPathsStillPresent && priorCommitsCarried;
+  checks[`${arm}_canonical_basis_unchanged`] =
+    row.head_commit === "95b83e71ee9a37041b9918b5e8b797eebabf69c9" &&
+    row.revision === 2 &&
+    latest?.basis?.headCommit === row.head_commit;
+
+  console.log(
+    "DELIVERY_RECORD_ARM " +
+      JSON.stringify({
+        arm,
+        expected,
+        beforeHead: beforePulse.basis.headCommit,
+        head,
+        beforeRecorded,
+        recorded,
+        delivered:
+          latest?.intent === "DELIVER" &&
+          (latest.check.artifacts ?? []).some(
+            (state) => state.path === expected.committedArtifact && state.commit === expected.commit && state.committed === true,
+          ),
+        artifact,
+        expectedDigest: digest,
+        refresh,
+      }),
+  );
+}
+
+console.log("DELIVERY_RECORD " + JSON.stringify({ checks }));
+process.exitCode = Object.values(checks).every(Boolean) ? 0 : 1;
