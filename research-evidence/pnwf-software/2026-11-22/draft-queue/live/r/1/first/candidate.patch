+/**
+ * The paths whose blob content differs between two revisions, as a direct-commit observation.
+ *
+ * A direct commit is not a delivery declaration: this observer only says which files the commit
+ * changed. It drops deletions and non-blob entries so a caller never offers a path that cannot be
+ * recorded as a present, committed artifact. A null return means the diff could not be read, which
+ * is reported as unknown, never as an empty change set.
+ */
+export function changedBlobPaths(
+  run: (args: readonly string[]) => string | null,
+  baseRevision: string,
+  headRevision: string,
+): readonly string[] | null {
+  if (baseRevision === "" || headRevision === "") return null;
+  if (baseRevision === headRevision) return [];
+  const output = run(["diff", "--name-only", "--no-renames", "-z", baseRevision, headRevision]);
+  if (output === null) return null;
+  const paths = output
+    .split("\0")
+    .filter((path) => path !== "");
+  const blobs: string[] = [];
+  for (const path of paths) {
+    if (!blobs.includes(path) && run(["cat-file", "-t", `${headRevision}:${path}`])?.trim() === "blob") {
+      blobs.push(path);
+    }
+  }
+  return Object.freeze(blobs);
+}
