+import assert from 'node:assert/strict';
+import {readFileSync} from 'node:fs';
+import test from 'node:test';
+test('both rejected replay receipts are available', () => {
+  const expected = ["maintenance-rejection-deac986ce8e798e90f73903e1148adde3265606ab782f65b392aeffff6c0d037","maintenance-rejection-9fd49e5bea8c3a68813211b04827abc737a7ed9e8a788ddb65ea82a45c79495c"];
+  const load = arm => JSON.parse(readFileSync('evidence/rejection/' + arm + '/receipt.json'));
+  assert.deepEqual(['without', 'with'].map(arm => load(arm).id), expected);
+});
