+++ b/scripts/pnwf/software/self-maintenance-delivery-required.mjs
@@ -0,0 +1,129 @@
+/**
+ * Independent replay for the "commit preserved, episode not recorded" gap.
+ *
+ * The sealed rejection sessions called pulse, merged an already-prepared review commit, and
+ * stopped with `delivered: false` and no episode record. This oracle uses only the ordinary
+ * tools a resumed session has: it commits a review, reads the pulse, follows the FIRST legal
+ * Work command the pulse exposes, and checks that the delivery is then actually recorded.
+ *
+ * It deliberately does not read private product state to decide what to do; the journal check
+ * is a postcondition, not an input to the action.
+ */
+import { execFileSync } from "node:child_process";
+import { mkdtempSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { pathToFileURL } from "node:url";
+
+const candidateRoot = process.cwd();
+const { installProduct } = await import(pathToFileURL(join(candidateRoot, "dist/src/product.js")));
+const root = mkdtempSync(join(tmpdir(), "maintenance-delivery-required-"));
+const git = (...args) => execFileSync("git", ["-C", root, ...args], { encoding: "utf8" }).trim();
+const commit = message => {
+  git("add", "--", "maintenance.md");
+  git("-c", "user.name=Fixture", "-c", "user.email=fixture@example.invalid", "commit", "-qm", message);
+  return git("rev-parse", "HEAD");
+};
+git("init", "-q");
+const artifact = join(root, "maintenance.md");
+writeFileSync(artifact, "Maintenance basis\n");
+const basis = commit("Initial project basis");
+const stateDir = mkdtempSync(join(tmpdir(), "maintenance-delivery-state-"));
+const deployment = installProduct({ tools: { register: () => () => undefined } }, {
+  projectId: "delivery-required-repro",
+  repository: root,
+  stateDir,
+  execution: "in-place",
+  toolProfile: "normal",
+  standard: { statement: "Deliver the documented maintenance result.", clauses: [], derivedFrom: [], confirmed: true, notes: [] },
+});
+
+let ordinal = 0;
+function call(name, args) {
+  const tool = deployment.tools.find(entry => entry.name === name);
+  if (!tool) throw new Error(`Missing ordinary tool ${name}`);
+  const callId = `delivery-required-probe-${++ordinal}`;
+  return tool.execute(args, { name, callId, rootCallId: callId, arguments: args, signal: AbortSignal.timeout(20_000) });
+}
+
+const pulse = () => call("palimpsest_continuity", { action: "pulse" });
+const mechanical = value => (value.nextActions?.mechanical ?? []).join("\n");
+const workCommands = value => [...mechanical(value).matchAll(/palimpsest_work action=([a-z]+)(?: intent=([A-Z_]+))?/gu)]
+  .map(match => ({ action: match[1], intent: match[2] ?? null, text: match[0] }));
+const firstWorkCommand = value => workCommands(value)[0] ?? null;
+const pointsAtConclusion = value => /reply using the recorded conclusion/iu.test(mechanical(value));
+const hasEpisode = async () => (await deployment.application.projectWorkspace.journal())
+  .some(entry => entry.entry.title.startsWith("Episode conclusion:"));
+
+try {
+  await call("palimpsest_start", {
+    projectId: "delivery-required-repro",
+    goal: "Preserve the committed maintenance review for the next session.",
+    headCommit: basis,
+    tasks: [],
+  });
+
+  // The rejected replay reached exactly this state: a clean direct commit, no episode record.
+  writeFileSync(artifact, "# Preserved maintenance review\n\nReady for the next maintainer.\n");
+  const candidate = commit("Preserve the committed maintenance review");
+  const committed = await pulse();
+  const command = firstWorkCommand(committed);
+
+  // A later uncommitted edit must not inherit the delivery requirement.
+  writeFileSync(artifact, "Maintenance basis with a new draft\n");
+  const dirty = await pulse();
+  writeFileSync(artifact, "# Preserved maintenance review\n\nReady for the next maintainer.\n");
+
+  const checkpoints = mechanical(committed).includes("intent=CHECKPOINT");
+  const optionalProposal = /propose the next bounded step/iu.test(mechanical(committed));
+  const required = committed.requiredAction ?? null;
+  const commitOnlyRecorded = await hasEpisode();
+
+  let delivery = null;
+  if (command?.action === "conclude" && command.intent === "DELIVER") {
+    delivery = await call("palimpsest_work", {
+      action: "conclude",
+      intent: "DELIVER",
+      statement: "The committed maintenance review is the preserved work result for this episode.",
+      artifacts: ["maintenance.md"],
+    });
+  } else if (command !== null) {
+    delivery = await call("palimpsest_work", {
+      action: command.action,
+      ...(command.intent === null ? {} : { intent: command.intent }),
+      statement: "Follow the pulse's first legal action.",
+      ...(command.intent === "DELIVER" ? { artifacts: ["maintenance.md"] } : {}),
+    });
+  }
+
+  const afterDelivery = await pulse();
+  const status = deployment.controller.status();
+  const deliveryRecorded = delivery?.state === "RECORDED" && delivery?.conclusion?.intent === "DELIVER" &&
+    (await hasEpisode());
+  const checks = {
+    commitAloneLeavesNoEpisode: commitOnlyRecorded === false,
+    requiredActionPresent: required?.kind === "RECORD_DIRECT_DELIVERY" && required?.repositoryHead === candidate,
+    requiredActionExplainsTheGap: /Git commit is not an episode record/iu.test(required?.reason ?? ""),
+    firstLegalActionIsDeliver: command?.action === "conclude" && command?.intent === "DELIVER",
+    noCheckpointAlternative: checkpoints === false,
+    noOptionalProposal: optionalProposal === false,
+    dirtyWorkHasNoDeliveryRequirement: (dirty.requiredAction ?? null) === null,
+    executorCanRecordDelivery: deliveryRecorded === true && delivery?.session?.mayEnd === true,
+    afterDeliveryReusesConclusion: (afterDelivery.requiredAction ?? null) === null &&
+      firstWorkCommand(afterDelivery) === null && pointsAtConclusion(afterDelivery),
+    operatorBasisPreserved: status.headCommit === basis && status.attempts.length === 0 && status.promotions.length === 0,
+  };
+
+  console.log("DELIVERY_REQUIRED " + JSON.stringify({
+    basis,
+    candidate,
+    firstCommand: command,
+    requiredAction: required,
+    deliveryState: delivery?.state ?? null,
+    after: { requiredAction: afterDelivery.requiredAction ?? null, first: firstWorkCommand(afterDelivery), points: pointsAtConclusion(afterDelivery), episode: afterDelivery.episode?.state, mechanical: afterDelivery.nextActions?.mechanical, direct: status.directOutcome, tasks: status.tasks, blocked: status.promotionFence, entries: (await deployment.application.projectWorkspace.journal()).map(e=>e.entry.title) },
+    checks,
+  }));
+  process.exitCode = Object.values(checks).every(Boolean) ? 0 : 1;
+} finally {
+  await deployment.dispose();
+}
