       if (ready.length > 0) nextActions.push("agent: palimpsest_work action=next (mechanical step is legal)");
       if (active.length > 0 && running.length > 0) nextActions.push("agent: palimpsest_work action=complete when the work is done");
     }
+    /**
+     * PNWF-B/C: the pulse is the first ordinary read of a resumed session. A clean taskless
+     * repository with a direct commit is already a reviewable outcome, so it must not expose only
+     * CHECKPOINT and "propose the next step". This mirrors `palimpsest_work action=readiness`:
+     * before a conclusion, name the DELIVER action; after a current DELIVER, point at that
+     * conclusion instead of asking for a duplicate. Dirty, blocked and formal-task states keep
+     * their existing guidance.
+     */
+    const direct = status.directOutcome;
+    if (
+      status.tasks.length === 0 &&
+      pendingWork.length === 0 &&
+      blocked.length === 0 &&
+      verifying.length === 0 &&
+      !status.attempts.some((attempt) => ["CREATED", "LEASED", "RUNNING"].includes(attempt.state)) &&
+      direct?.relation === "DIRECT_AHEAD" &&
+      direct.uncommittedPaths.length === 0
+    ) {
+      let latestIndex = -1;
+      let latest: ReturnType<typeof parseEpisodeConclusion> = null;
+      for (let index = 0; index < entries.length; index += 1) {
+        const parsed = parseEpisodeConclusion(entries[index]!.entry.body);
+        if (parsed !== null) {
+          latest = parsed;
+          latestIndex = index;
+        }
+      }
+      const currentDeliver =
+        latest?.intent === "DELIVER" &&
+        latest.basis.projectRevision === basis.projectRevision &&
+        latest.basis.headCommit === basis.headCommit &&
+        latestIndex === entries.length - 1;
+      if (currentDeliver) {
+        nextActions.push("agent: reply using the recorded conclusion; it already covers this episode");
+      } else {
+        nextActions.push(
+          `agent: the repository has a direct commit at ${direct.repositoryHead?.slice(0, 12) ?? "unknown"}; ` +
+            "if it is the deliverable, call palimpsest_work action=conclude intent=DELIVER with your statement",
+        );
+      }
+    }
     if (openQuestions.length > 0) nextActions.push("agent: address an open question by investigation or a proposal; do not treat it as accepted");
     if (pendingWork.length === 0 && verifying.length === 0 && status.nextAction?.kind !== "NO_FORMAL_WORK") {
       nextActions.push("agent: propose the next bounded step in the project journal");
