@@ -0,0 +1,65 @@
+/** Independent ordinary-tool replay for direct-work guidance on the continuity pulse. */
+import { execFileSync } from "node:child_process";
+import { mkdtempSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { pathToFileURL } from "node:url";
+
+const candidateRoot = process.cwd();
+const { installProduct } = await import(pathToFileURL(join(candidateRoot, "dist/src/product.js")));
+const root = mkdtempSync(join(tmpdir(), "maintenance-pulse-"));
+const git = (...args) => execFileSync("git", ["-C", root, ...args], { encoding: "utf8" }).trim();
+const commit = message => {
+  git("add", "--", "maintenance.md");
+  git("-c", "user.name=Fixture", "-c", "user.email=fixture@example.invalid", "commit", "-qm", message);
+  return git("rev-parse", "HEAD");
+};
+git("init", "-q");
+const artifact = join(root, "maintenance.md");
+writeFileSync(artifact, "Maintenance basis\n");
+const basis = commit("Initial project basis");
+const stateDir = mkdtempSync(join(tmpdir(), "maintenance-pulse-state-"));
+const deployment = installProduct({ tools: { register: () => () => undefined } }, {
+  projectId: "direct-pulse-repro", repository: root, stateDir,
+  execution: "in-place", toolProfile: "normal",
+  standard: { statement: "Deliver the documented maintenance result.", clauses: [], derivedFrom: [], confirmed: true, notes: [] },
+});
+let ordinal = 0;
+function call(name, args) {
+  const tool = deployment.tools.find(entry => entry.name === name);
+  if (!tool) throw new Error(`Missing ordinary tool ${name}`);
+  const callId = `direct-pulse-probe-${++ordinal}`;
+  return tool.execute(args, { name, callId, rootCallId: callId, arguments: args, signal: AbortSignal.timeout(20_000) });
+}
+const pulse = () => call("palimpsest_continuity", { action: "pulse" });
+const mechanical = value => (value.nextActions?.mechanical ?? []).join("\n");
+const recommendsDeliver = value => /palimpsest_work action=conclude intent=DELIVER/iu.test(mechanical(value));
+const pointsAtConclusion = value => /reply using the recorded conclusion/iu.test(mechanical(value));
+try {
+  await call("palimpsest_start", { projectId: "direct-pulse-repro", goal: "Finish the maintenance update.", headCommit: basis, tasks: [] });
+  const initial = await pulse();
+  writeFileSync(artifact, "Maintenance result\n");
+  const dirty = await pulse();
+  const candidate = commit("Finish direct maintenance result");
+  const committed = await pulse();
+  const delivered = await call("palimpsest_work", { action: "conclude", intent: "DELIVER",
+    artifacts: ["maintenance.md"], statement: "The direct maintenance result is committed and reviewable." });
+  const afterDelivery = await pulse();
+  writeFileSync(artifact, "Maintenance result with uncommitted changes\n");
+  const dirtyAfterDelivery = await pulse();
+  const status = deployment.controller.status();
+  const checks = {
+    initialHasNoDeliveryAdvice: !recommendsDeliver(initial),
+    dirtyHasNoDeliveryAdvice: !recommendsDeliver(dirty) && !pointsAtConclusion(dirty),
+    cleanCommitSuggestsDelivery: committed.episode.state === "OPEN" && recommendsDeliver(committed),
+    recordedDeliveryCanClose: delivered.state === "RECORDED" && delivered.session.mayEnd,
+    afterDeliveryPointsAtConclusion: afterDelivery.episode.state === "DELIVERED" && pointsAtConclusion(afterDelivery) &&
+      !recommendsDeliver(afterDelivery),
+    dirtyAfterDeliveryHasNoDeliveryAdvice: !recommendsDeliver(dirtyAfterDelivery) && !pointsAtConclusion(dirtyAfterDelivery),
+    operatorBasisPreserved: status.headCommit === basis && status.attempts.length === 0 && status.promotions.length === 0,
+  };
+  console.log("DIRECT_PULSE " + JSON.stringify({ basis, candidate, checks, initial, dirty, committed, afterDelivery, dirtyAfterDelivery }));
+  process.exitCode = Object.values(checks).every(Boolean) ? 0 : 1;
+} finally {
+  await deployment.dispose();
+}
