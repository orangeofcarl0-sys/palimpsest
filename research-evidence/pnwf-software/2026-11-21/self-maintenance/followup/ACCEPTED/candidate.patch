+  it("guides a task-free project to its direct commit, then to the current conclusion", async () => {
+    const { repo, head, stateDir } = workspace("direct-delivery");
+    const installed = install(repo, stateDir);
+    await start(installed, head, []);
+
+    type Readiness = {
+      action: string;
+      reasons: string[];
+      next: string[];
+      directOutcome: { relation: string; repositoryHead: string | null } | null;
+    };
+    const readiness = async () => (await call(installed, "palimpsest_work", { action: "readiness" })) as unknown as Readiness;
+
+    // An unchanged clean repository is not a new delivery.
+    const unchanged = await readiness();
+    expect(unchanged.action).toBe("CONTINUE_WORK");
+    expect(unchanged.next.join(" ")).not.toContain("intent=DELIVER");
+
+    // An uncommitted draft is real work, but it is not a committed delivery either.
+    mkdirSync(join(repo, "deliverables"), { recursive: true });
+    writeFileSync(join(repo, "deliverables", "package.md"), "# Package\n\nCommitted outside Work.\n");
+    const uncommitted = await readiness();
+    expect(uncommitted.action).toBe("CONTINUE_WORK");
+    expect(uncommitted.reasons.join(" ")).toMatch(/uncommitted changes/iu);
+    expect(uncommitted.next.join(" ")).not.toContain("intent=DELIVER");
+
+    execFileSync("git", ["add", "-A"], { cwd: repo });
+    execFileSync("git", ["-c", "user.email=t@t.t", "-c", "user.name=t", "commit", "-qm", "direct delivery"], { cwd: repo });
+    const direct = execFileSync("git", ["rev-parse", "HEAD"], { cwd: repo, encoding: "utf8" }).trim();
+    expect(direct).not.toBe(head);
+
+    const committed = await readiness();
+    expect(committed.action).toBe("SEMANTIC_JUDGEMENT");
+    expect(committed.directOutcome).toMatchObject({ relation: "DIRECT_AHEAD", repositoryHead: direct });
+    expect(committed.reasons.join(" ")).toContain(direct);
+    expect(committed.reasons.join(" ")).toContain("deliverables/package.md");
+    expect(committed.next.join(" ")).toContain("intent=DELIVER");
+
+    const delivered = (await call(installed, "palimpsest_work", {
+      action: "conclude",
