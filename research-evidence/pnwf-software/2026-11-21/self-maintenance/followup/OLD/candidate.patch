+/**
+ * PNWF-D — a project with NO formal task is a legitimate shape.
+ *
+ * A direct commit is a real repository outcome, but it is not a governed result. When the worktree is
+ * clean, the commit is ahead of the canonical head, and the episode has no delivery blocker, the
+ * honest next step is the principal's judgement on that EXISTING commit — not "plan or begin work".
+ * The same read after DELIVER must point at the recorded conclusion instead of restarting planning.
+ *
+ * Initial IN_SYNC (no commit beyond the canonical basis), uncommitted paths, open attempts and a
+ * current project/journal change all keep the ordinary guidance: equality of heads alone proves no
+ * direct outcome, and a dirty tree is unsettled work. This helper never accepts, promotes or advances
+ * the canonical head; it only chooses the semantic guidance class and its next calls.
+ */
+async function directDelivery(
+  deps: WorkRuntimeDeps,
+  status: ReturnType<WorkRuntimeDeps["controller"]["status"]>,
+  requested: string | null,
+): Promise<{ reasons: string[]; next: string[] } | null> {
+  const { controller, deliveryPulse } = deps;
+  const direct = status.directOutcome;
+  const repository = controller.effects.git.repository;
+  if (
+    requested !== null || deliveryPulse === undefined || repository === undefined ||
+    direct === null || direct === undefined || status.tasks.length > 0 ||
+    status.attempts.some(
+      (attempt) =>
+        attempt.orphaned === true || attempt.state === "CREATED" || attempt.state === "LEASED" || attempt.state === "RUNNING",
+    )
+  ) return null;
+
+  const pulse = await deliveryPulse.pulse().catch(() => null);
+  if (
+    pulse === null || pulse.basis.projectRevision !== status.revision || pulse.basis.headCommit !== status.headCommit ||
+    pulse.episode.readiness.deliveryBlockers.length > 0 || pulse.episode.readiness.failedOrBlockedTasks.length > 0 ||
+    pulse.execution.jobs.some((job) => job.phase === "QUEUED" || job.phase === "RUNNING")
+  ) return null;
+
+  // Re-observe Git after the asynchronous episode read: a moved or unobservable tree is not the
+  // position the pulse described. A current conclusion is reported even over uncommitted bytes; it
+  // is an advisory episode judgement, never evidence that those bytes were committed or accepted.
+  const basis = observeCanonicalBasis(repository);
+  if (basis?.head !== direct.repositoryHead) return null;
+
+  const conclusion = pulse.episode.current ? pulse.episode.conclusion : null;
+  if (conclusion !== null) {
+    const uncommitted = basis.uncommittedPaths ?? [];
+    return {
+      reasons: [
+        `this episode has a current recorded ${conclusion.intent} conclusion (${conclusion.conclusionId}) at repository HEAD ${basis.head}`,
+        uncommitted.length > 0
+          ? `the worktree still has uncommitted paths (${uncommitted.join(", ")}); the conclusion remains the current episode judgement and does not accept those bytes`
+          : "the worktree is clean; the conclusion is advisory and did not accept the artifact, promote a result or advance the canonical head",
+      ],
+      next: ["reply using the recorded conclusion"],
+    };
+  }
+
+  // No current conclusion: only a clean tree with a real commit beyond the canonical basis is
+  // direct delivery work. Uncommitted or unchanged state keeps the ordinary guidance.
+  if (basis.uncommittedPaths?.length !== 0) return null;
+  if (direct.relation !== "DIRECT_AHEAD" || basis.head === direct.projectHead) return null;
+  return {
+    reasons: [
+      `repository HEAD ${basis.head} is a direct commit ahead of the canonical ProjectIR head ${direct.projectHead}, and the working tree is clean`,
+      "no formal task is declared, so this commit is a repository outcome rather than a governed result; this readiness does not accept or promote it",
+      "assess whether the committed outcome satisfies the user's goal",
+    ],
+    next: [
+      "inspect the paths committed by the direct commit",
+      "if they satisfy the goal, call palimpsest_work action=conclude intent=DELIVER with your statement and the committed artifact paths",
+    ],
+  };
+}
