{"type":"tool_result","callId":"call_4675255eefae41ba8673870e","status":"completed","result":"    controller,\n    proof,\n    reasoning: reasoningCellsInstalled?.service,\n    projectWorkspace,\n    admission: options.projectIntentAdmission,\n    clock: options.clock,\n  });\n\n  /*\n   * E3-C §30/§31: the PROJECT-GROUNDED COLLABORATION surface.\n   *\n   * It composes from the Work owner (to observe Project reality) and the EXISTING Federation service (to\n   * declare a durable need). It owns no store, no peer identity, no Work and no authority — the admission\n   * authority is the CALLER's, supplied through `options.projectCollaborationAdmission`, and the authoring\n   * seam through `options.projectCollaborationAuthoring`.\n   *\n   * ABSENCE IS HONEST: without a Federation service there is no declaration owner, so the surface is\n   * simply absent rather than stubbed.\n   */\n  const projectCollaboration = composeProjectCollaborationCapability({\n    projectId: options.projectId,\n    controller,\n    federation,\n    authoring: options.projectCollaborationAuthoring,\n    admission: options.projectCollaborationAdmission,\n    clock: options.clock,\n  });\n\n  /*\n   * E4-L §24/§30: the GOVERNED INSTITUTIONAL LEARNING surface.\n   *\n   * It connects the EXISTING evolution histories to the EXISTING empirical memory: reconciliation projects\n   * every ACTIVATED structural change into exactly one `InterventionRecord`, and the evaluation read joins\n   * an intervention to the ordinary experiments that studied it.\n   *\n   * It owns NO store, NO Organization, NO RuntimeScope, NO DynamicsProposal and NO authority — it reads\n   * evolution history and writes only through OrganizationMemory's own `recordIntervention`. ABSENCE IS\n   * HONEST: without an evolution history or the memory owner there is nothing to connect, so the face is\n   * simply absent rather than stubbed.\n   */\n  const institutionalLearning = composeInstitutionalLearningCapability({\n    organizationEvolutionStore: options.organizationEvolutionStore,\n    runtimeEvolutionStore: options.runtimeEvolutionStore,\n    organizationMemory,\n    clock: options.clock,\n  });\n\n  /*\n   * PC1 S03/S06: the DERIVED continuity and domain-outcome composition. It reads the existing Work\n   * owner, workspace/journal and promotion facts, and owns nothing; install.ts only decides to\n   * compose it.\n   */\n  const { continuity, domainOutcome, contribution, pulse, episode } = composeContinuityCapability({\n    projectId: options.projectId,\n    controller: {\n      project: () => controller.work.project(),\n      status: () => controller.status(),\n      plan: (input) => controller.plan(input),\n      promotionFacts: () => controller.promotions.promotionFactsSync(),\n      /**\n       * LHAPE-B: the canonical ProjectIR revisions, ascending. The ProjectIR itself is carried in the\n       * `PROJECT_REVISED` payload, so this is a READ over the ONE event log — not a second history.\n       */\n      revisionHistory: () =>\n        controller.store\n          .listEvents(options.projectId)\n          .filter((event) => event.event_type === \"PROJECT_CREATED\" || event.event_type === \"PROJECT_REVISED\")\n          .map((event) => event.payload.project_ir as ProjectIr)\n          .sort((left, right) => left.revision - right.revision),\n      /**\n       * PWRS-C: the result commit a governed candidate was exported under. Reading it lets the episode\n       * name and digest a candidate that the canonical worktree does not contain.\n       */\n      attemptResultCommit: (attemptId: string) => {\n        try {\n          return controller.promotions.canonicalAttemptResultCommit(attemptId);\n        } catch {\n          return null;\n        }\n      },\n    },\n    projectWorkspace,\n    ...(delegation === undefined ? {} : { delegation }),\n    ...(workDelegation === undefined ? {} : { workDelegation }),\n    executionPlacement: controller.execution,\n    ...(options.repository === undefined ? {} : { repository: options.repository }),\n    ...(options.clock === undefined ? {} : { clock: options.clock }),\n    operatorIntentAdmission: options.projectIntentAdmission !== undefined,\n  });\n\n  // §20: the aggregate surface and the tool set are assembled from the composed groups; this\n  // file no longer knows which capability faces exist.\n  const assembly = composeApplicationAssembly({\n    controller,\n    baseTools,\n    collaboration: collaborationCluster,\n    organization: organizationCluster,\n    cognition,\n    governance,\n    collaborationService: collaboration,\n    crossProjectService: crossProject,\n    delegationService: delegation,\n    continuity,\n    domainOutcome,\n    ...(contribution === undefined ? {} : { contribution }),\n    ...(pulse === undefined ? {} : { pulse }),\n    ...(episode === undefined ? {} : { episode }),\n    ...(workDelegation === undefined ? {} : { workDelegation }),\n    ...(continuation === undefined ? {} : { continuation }),\n    ...(executionRelay === undefined ? {} : { executionRelay }),\n    assemblyOptions: options,\n  });\n  const { application, tools } = assembly;\n\n\n  // §12/§14: registration and disposal are one explicit lifecycle composition, so the\n  // ownership rules live in one reviewable place (`src/composition/lifecycle.ts`).\n  const lifecycle = composeInstalledLifecycle({\n    context,\n    tools,\n    controller,\n/**\n * PC1 S03/S06 — the continuity/outcome composition.\n *\n * It is the ONE place that adapts the existing Work owner, the derived workspace/journal and the\n * promotion facts into the read-only continuity facade and the explicit domain-outcome service.\n * It owns no store and decides no authority; install.ts only decides to compose it.\n */\nimport { execFileSync } from \"node:child_process\";\nimport { createHash } from \"node:crypto\";\nimport { existsSync, readFileSync, statSync } from \"node:fs\";\nimport { isAbsolute, relative, resolve } from \"node:path\";\n\nimport { makeProjectContinuityService } from \"../project_continuity/index.js\";\nimport type { ProjectContinuityService } from \"../project_continuity/index.js\";\nimport {\n  artifactChangeReasons,\n  episodeArtifactWarnings,\n  episodeConclusionBody,\n  makeEpisodeConclusion,\n  validateEpisodeConclusion,\n  type EpisodeArtifactState,\n  type EpisodeConclusionInput,\n  type EpisodeConclusionResult,\n  type EpisodeService,\n} from \"../project_continuity/index.js\";\nimport { makeDomainOutcomeService } from \"../domain_outcome/index.js\";\nimport type { DomainOutcomeService } from \"../domain_outcome/index.js\";\nimport { makeContributionService } from \"../project_contribution/index.js\";\nimport type {\n  ContributionChangeClass,\n  ContributionDelegationPort,\n  ContributionPlanChange,\n  ContributionService,\n} from \"../project_contribution/index.js\";\nimport { makeProjectPulseService } from \"../project_pulse/index.js\";\nimport type { ProjectPulseService, PulseDelegationPort } from \"../project_pulse/index.js\";\nimport type { ProjectWorkspaceService } from \"../project_workspace/index.js\";\nimport {\n  executionRelayBody,\n  makeExecutionRelayRecord,\n  type ExecutionAttribution,\n} from \"../work/execution_relay.js\";\nimport type { Decision, ProjectIr, Requirement, TaskSpec } from \"../schema/models.js\";\n/** The canonical project revision this composition projects; re-exported for the install root. */\nexport type { ProjectIr } from \"../schema/models.js\";\n\ninterface ContinuityWorkOwner {\n  project(): ProjectIr;\n  status(): {\n    revision: number;\n    headCommit: string;\n    schedulerState: string;\n    tasks: readonly { task_id: string; state: string }[];\n    attempts: readonly {\n      attempt_id: string;\n      task_id: string | null;\n      state: string;\n      orphaned?: boolean;\n      task_state?: string;\n    }[];\n    evidence: readonly { evidence_id: string; status: string }[];\n    promotions: readonly { promotion_id: string; state: string }[];\n    promotionFence: readonly { promotion_id: string; attempt_id: string; task_id: string; state: string }[];\n  };\n  plan(input: {\n    goal: string;\n    requirements: readonly Requirement[];\n    decisions: readonly Decision[];\n    tasks: readonly TaskSpec[];\n    reason?: string | undefined;\n    changeClass?: ContributionChangeClass | undefined;\n    changedIds?: readonly string[] | undefined;\n  }): unknown;\n  promotionFacts(): readonly {\n    promotionId: string;","truncated":true}
