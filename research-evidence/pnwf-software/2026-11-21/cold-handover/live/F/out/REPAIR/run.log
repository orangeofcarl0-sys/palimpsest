{"type":"tool_call","callId":"call_0bfcccb3db294b59ad018ce9","tool":"bash","input":{"command":"python3 - <<'PY'\nfrom pathlib import Path\np=Path('host/dsh/lib/inspector/graph.js')\ns=p.read_text()\nold='''  function finish() {\n    const sort = (a, b) => a.id < b.id ? -1 : a.id > b.id ? 1 : 0;\n    return { nodes: [...nodes.values()].sort(sort), edges: [...edges.values()].filter(e => nodes.has(e.from) && nodes.has(e.to)).sort(sort), coverage };\n  }\n  return { node, edge, coverage, finish };\n'''\nnew='''  function finish() {\n    const sort = (a, b) => a.id < b.id ? -1 : a.id > b.id ? 1 : 0;\n    return { nodes: [...nodes.values()].sort(sort), edges: [...edges.values()].filter(e => nodes.has(e.from) && nodes.has(e.to)).sort(sort), coverage };\n  }\n  const has = id => nodes.has(id);\n  return { node, edge, has, coverage, finish };\n'''\nassert old in s\ns=s.replace(old,new)\nold2='''  if (ep.conclusion) {\n    const c = ep.conclusion;\n    const n = d.node(key('episode', c.conclusionId), 3, '会话结论', c.intent, ep.state, '项目接续', c.conclusionId,\n      { 陈述: c.statement, 等待: c.waitingOn, 仍适用: ep.current, 时间: c.recordedAt });\n    d.edge(root, n, '记录结论', '项目接续');\n  }\n'''\nnew2='''  if (ep.conclusion) {\n    const c = ep.conclusion;\n    const n = d.node(key('episode', c.conclusionId), 3, '会话结论', c.intent, ep.state, '项目接续', c.conclusionId,\n      { 陈述: c.statement, 等待: c.waitingOn, 仍适用: ep.current, 交付版本: ep.deliveredVersion ?? null,\n        当前接受版本: ep.acceptedVersion ?? null, 时间: c.recordedAt });\n    d.edge(root, n, '记录结论', '项目接续');\n    // The episode names the exact committed bytes it judged. Draw the delivered version even when a\n    // later acceptance moved the project head, so an old conclusion remains traversable.\n    for (const sha of [ep.deliveredVersion, ep.acceptedVersion]) {\n      if (typeof sha !== 'string' || sha === '') continue;\n      if (!d.has(key('commit', sha))) d.node(key('commit', sha), 3, '交付版本', sha.slice(0, 12), null, '项目接续', sha);\n      d.edge(n, key('commit', sha), sha === ep.acceptedVersion ? '当前接受版本' : '当时交付版本', '项目接续', sha);\n    }\n  }\n'''\nassert old2 in s\ns=s.replace(old2,new2)\np.write_text(s)\nprint('patched inspector graph')\nPY\npython3 - <<'PY'\nfrom pathlib import Path\np=Path('host/dsh/lib/inspector/observe.js')\ns=p.read_text()\nold=\"\"\"        if (entry.projectId !== projectId || entry.kind !== 'REFERENCE_NOTE' ||\n            !entry.relatedRefs.some(r => r.kind === 'git_commit' && r.id === head)) continue;\"\"\"\nnew=\"\"\"        if (entry.projectId !== projectId || entry.kind !== 'REFERENCE_NOTE' ||\n            !entry.relatedRefs.some(r => (r.kind === 'git_commit' || r.kind === 'commit') && r.id === head)) continue;\"\"\"\nassert old in s\ns=s.replace(old,new)\np.write_text(s)\nprint('patched inspector note ref kinds')\nPY","description":"Show historical delivery links in inspector graph"}}
