nance.startsWith(\"relay:\")) return true;\n  return entry.entry.relatedRefs.some((ref) => isCommitRef(ref.kind));\n}\n'''\nassert old2 in s\ns=s.replace(old2,new2)\n# acceptedResults const and direct item insertion\nold3='''    const acceptedResults = promotionFacts.map((fact) => {\n      const taskId = taskByAttempt.get(fact.attemptId) ?? null;\n      const superseded = taskId !== null && lastPromotionByTask.get(taskId) !== fact.promotionId;\n      return item({\n        id: `promotion:${fact.promotionId}`,\n        standing: \"ACCEPTED_FOR_PURPOSE\",\n        title: `Accepted result for ${taskId ?? \"a completed task\"}`,\n        detail: `source commit ${fact.sourceCommit} was promoted onto ${fact.expectedHeadCommit}; resulting head ${fact.resultingHeadCommit}`,\n        sourceRefs: [`promotion:${fact.promotionId}`, `commit:${fact.sourceCommit}`, `commit:${fact.resultingHeadCommit}`],\n        basis,\n        adoptionBasis: \"the promotion effect recorded by the canonical Promotion path\",\n        reopenConditions: [\"a later accepted source revision or a re-evaluation of the result's subject\"],\n        historicalAcceptance: \"ACCEPTED\",\n        currentApplicability: superseded ? \"SUPERSEDED\" : \"UNKNOWN\",\n        applicabilityBasis: superseded\n          ? \"a later accepted result for the same task exists; the earlier result remains historical\"\n          : \"no current-world compatibility assessment is composed for this result; historical acceptance is not proof that it still applies\",\n      });\n    });\n'''\nnew3='''    const acceptedResults: ContinuityItem[] = promotionFacts.map((fact) => {\n      const taskId = taskByAttempt.get(fact.attemptId) ?? null;\n      const superseded = taskId !== null && lastPromotionByTask.get(taskId) !== fact.promotionId;\n      return item({\n        id: `promotion:${fact.promotionId}`,\n        standing: \"ACCEPTED_FOR_PURPOSE\",\n        title: `Accepted result for ${taskId ?? \"a completed task\"}`,\n        detail: `source commit ${fact.sourceCommit} was promoted onto ${fact.expectedHeadCommit}; resulting head ${fact.resultingHeadCommit}`,\n        sourceRefs: [`promotion:${fact.promotionId}`, `commit:${fact.sourceCommit}`, `commit:${fact.resultingHeadCommit}`],\n        basis,\n        adoptionBasis: \"the promotion effect recorded by the canonical Promotion path\",\n        reopenConditions: [\"a later accepted source revision or a re-evaluation of the result's subject\"],\n        historicalAcceptance: \"ACCEPTED\",\n        currentApplicability: superseded ? \"SUPERSEDED\" : \"UNKNOWN\",\n        applicabilityBasis: superseded\n          ? \"a later accepted result for the same task exists; the earlier result remains historical\"\n          : \"no current-world compatibility assessment is composed for this result; historical acceptance is not proof that it still applies\",\n      });\n    });\n'''\nassert old3 in s\ns=s.replace(old3,new3)\n# insert episode records after candidates/negative? Put after negativeFindings before openQuestions to use entries.\nmarker='''    const openQuestions = entries\n      .filter(\n'''\ninsert='''    /**\n     * HANDOFF TRACE: an episode conclusion is itself a journal record, so `explain` must be able to\n     * resolve its conclusion id. Keep it separate from open questions and candidate work: it is an\n     * advisory judgement at a recorded basis, and its source refs name the journal entry, the exact\n     * delivered commit(s), and (when the delivery is now accepted) the acceptance record.\n     */\n    const episodeRecords = entries.flatMap((view) => {\n      const conclusion = parseEpisodeConclusion(view.entry.body);\n      return conclusion === null ? [] : [{ view, conclusion }];\n    });\n    const recordedReferenceEntries = entries.filter(\n      (view) => view.entry.kind === \"REFERENCE_NOTE\" && recordedReference(view) && parseEpisodeConclusion(view.entry.body) === null,\n    );\n    const noteIdsForCommit = (commit: string): readonly string[] =>\n      recordedReferenceEntries\n        .filter((view) => relatedCommitIds(view).some((id) => commitReferenceMatches(id, commit)))\n        .map((view) => `journal:${view.entry.entryId}`);\n    const admittedDirectVersion = status.directOutcome?.admittedDirectCommit ?? null;\n\n    const episodeConclusions: ContinuityItem[] = episodeRecords.map(({ view, conclusion }) => {\n      const delivered = episodeDeliveredCommits(conclusion);\n      const matchesAccepted =\n        admittedDirectVersion !== null && delivered.some((commit) => commitReferenceMatches(commit, admittedDirectVersion));\n      const refs = new Set<string>([`episode:${conclusion.conclusionId}`, `journal:${view.entry.entryId}`]);\n      if (view.entry.provenance !== \"\") refs.add(view.entry.provenance);\n      for (const commit of delivered) {\n        refs.add(`commit:${commit}`);\n        if (matchesAccepted) for (const noteRef of noteIdsForCommit(commit)) refs.add(noteRef);\n      }\n      if (matchesAccepted) refs.add(`commit:${admittedDirectVersion}`);\n      const deliveredText =\n        delivered.length === 0 ? \"no committed version was recorded for its artifacts\" : `delivered version ${delivered.join(\", \")}`;\n      const acceptedText =\n        admittedDirectVersion === null\n          ? \"no operator-mediated accepted version is visible in this read\"\n          : matchesAccepted\n            ? `that is also the currently accepted project version ${admittedDirectVersion}`\n            : `the currently accepted project version is ${admittedDirectVersion}, which is not the version this conclusion delivered`;\n      return item({\n        id: `episode:${conclusion.conclusionId}`,\n        standing: \"AGENT_INTERPRETATION\",\n        title: view.entry.title === \"\" ? `Episode conclusion: ${conclusion.intent}` : view.entry.title,\n        detail:\n          `${conclusion.intent}: ${conclusion.statement} Recorded at revision ${String(conclusion.basis.projectRevision