+export function episodeDeliveredCommits(conclusion: EpisodeConclusion): readonly string[] {
+  const commits = new Set<string>();
+  for (const artifact of conclusion.check.artifacts ?? []) {
+    if (typeof artifact.commit === "string" && artifact.commit !== "") commits.add(artifact.commit);
+  }
