+  it("reports an unconfirmed Git observation without inventing uncommitted changes", () => {
+    const state = (
+      detail: string,
+      overrides: Partial<{
+        present: boolean;
+        tracked: boolean;
+        committed: boolean;
+        source: "WORKTREE" | "RESULT_COMMIT" | "ABSENT";
+      }> = {},
+    ) => ({ path: "deliverables/package.md", present: true, tracked: true, committed: false, source: "WORKTREE" as const, detail, ...overrides });
+    const hint = (detail: string, overrides: Parameters<typeof state>[1] = {}) =>
+      episodeArtifactWarnings([state(detail, overrides)]).join(" ");
+
+    // A genuinely dirty tracked file keeps its exact meaning.
+    expect(hint("tracked with uncommitted changes")).toMatch(/has uncommitted changes/iu);
+
+    // An observation problem is described as such, not as a working-tree change.
+    for (const detail of [
+      "HEAD changed during artifact observation",
+      "HEAD could not be verified",
+      "artifact blob could not be read at observed HEAD",
+    ]) {
+      const warning = hint(detail);
+      expect(warning).toContain(detail);
+      expect(warning).toMatch(/Git provenance could not be confirmed/iu);
+      expect(warning).not.toMatch(/uncommitted changes/iu);
+    }
+
+    // The existing meanings of committed, missing, untracked and candidate artifacts are unchanged.
+    expect(hint("committed at HEAD", { committed: true })).toBe("");
+    expect(hint("not found in the worktree", { present: false, tracked: false })).toMatch(/was not found/iu);
+    expect(hint("not tracked by Git", { tracked: false })).toMatch(/not tracked by Git/iu);
+    expect(
+      hint("present in the result commit of attempt a1 — a governed candidate, not an accepted project asset", {
+        committed: true,
+        source: "RESULT_COMMIT",
+      }),
+    ).toBe("");
+  });
+
