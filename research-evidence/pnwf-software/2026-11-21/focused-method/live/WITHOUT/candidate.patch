+/**
+ * The observer records why a tracked file could not be confirmed at HEAD in `detail`. Those reasons
+ * are NOT evidence of a dirty file: HEAD can move while the blob is read, HEAD can be unverifiable,
+ * or the Git object can be unreadable. Only the observer's explicit dirty result is an uncommitted
+ * change, so classify the observation before choosing the provenance warning.
+ */
+function artifactObservationIssue(detail: string): string | null {
+  const normalized = detail.trim().toLowerCase();
+  if (normalized.includes("head changed") || normalized.includes("head moved")) {
+    return "HEAD changed during artifact observation";
+  }
+  if (normalized.includes("head could not be verified") || normalized.includes("head could not be confirmed")) {
+    return "HEAD could not be verified";
+  }
+  if (normalized.includes("blob could not be read") || normalized.includes("artifact could not be read")) {
+    return `the Git blob could not be read (${detail.trim()})`;
+  }
+  return null;
+}
+
 /** Provenance facts are reported, never turned into an acceptance or a refusal by themselves. */
 export function episodeArtifactWarnings(states: readonly EpisodeArtifactState[]): readonly string[] {
   const warnings: string[] = [];
