     } else if (!state.tracked) {
       warnings.push(`artifact ${state.path} is not tracked by Git; the final bytes exist only in the working tree`);
     } else if (!state.committed) {
-      warnings.push(`artifact ${state.path} is tracked but has uncommitted changes; HEAD does not contain the final bytes`);
+      const observationIssue = artifactObservationIssue(state.detail);
+      if (observationIssue !== null) {
+        warnings.push(
+          `artifact ${state.path} is tracked, but its commit state could not be confirmed: ${observationIssue}; this is an observation problem, not a working-tree change`,
+        );
+      } else {
+        warnings.push(`artifact ${state.path} is tracked but has uncommitted changes; HEAD does not contain the final bytes`);
+      }
     }
   }
   return Object.freeze(warnings);
