{"type":"tool_result","callId":"call_9f8caf6a3d404fba886d05e4","status":"completed","result":"<path>/run/stage/world/board.mjs</path>\n<type>file</type>\n<content>\n1: // The currently deployed board expands only the query's civil date.\n2: export function departures(feed, stop, start, minutes) {\n3:   const from = Date.parse(start);\n4:   const date = new Date(from).toISOString().slice(0, 10);\n5:   const midnight = Date.parse(date + \"T00:00:00Z\");\n6:   const rows = [];\n7:   for (const trip of feed.trips) {\n8:     const override = feed.exceptions.find(x => x.service === trip.service && x.date === date);\n9:     if (!(override?.active ?? feed.calendar[trip.service]?.includes(date)) || trip.stop !== stop) continue;\n10:     const [h,m,s] = trip.clock.split(\":\").map(Number);\n11:     const time = midnight + 1000 * (3600*h + 60*m + s);\n12:     if (time >= from && time < from + minutes*60000) {\n13:       rows.push({tripId:trip.tripId, serviceDate:date, departure:new Date(time).toISOString()});\n14:     }\n15:   }\n16:   return rows.sort((a,b) => a.departure.localeCompare(b.departure) || a.tripId.localeCompare(b.tripId));\n17: }\n\n(End of file - total 17 lines)\n</content>"}
