{"type":"tool_call","callId":"call_e009b677692f456aa03ed0a2","tool":"bash","input":{"command":"cd /run/stage/world && node - <<'EOF'\nconst fs=require('fs');\nconst plan=JSON.parse(fs.readFileSync('shift-plan.json'));\nconst rel=JSON.parse(fs.readFileSync('release.json'));\nconst night=JSON.parse(fs.readFileSync('night.json'));\nconst limits=[80,40,50,70];\nconst actual=plan.acKw.map((p,i)=>Math.min(p,limits[i]));\nconst dep=[night.buses[0].startKwh+night.buses[0].untilSlot*0+0.5*0.9*(actual[0]+actual[1]), night.buses[1].startKwh+0.5*0.9*(actual[2]+actual[3])];\nconsole.log({plan:plan.acKw,limits,actual,dep,within:plan.acKw.every((p,i)=>p<=limits[i])});\nconsole.log('release',rel);\nconst assert=(c,m)=>{if(!c)throw new Error(m)};\nassert(JSON.stringify(rel.departureKwh)===JSON.stringify(dep),'departure mismatch');\nassert(JSON.stringify(rel.marginKwh)===JSON.stringify([0,0]),'margin mismatch');\nassert(rel.at90.A==='GO'&&rel.at90.B==='GO','at90 mismatch');\nassert(rel.at85.A==='HOLD'&&rel.at85.B==='HOLD','at85 mismatch');\nassert(rel.evidenceSha==='341e19e288de9f561f85fcb66a7a910ff6f3e143','evidence mismatch');\nconsole.log('release checks OK');\nEOF\necho '-- originals unchanged vs 234b532 --'; git diff --exit-code 234b532 -- operations/original-receipt.json operations/cold-cycle.json operations/retest.mjs model.mjs night.json && echo unchanged; echo '-- final log --'; git log --oneline -7","description":"Verify final release values and preserved originals"}}
