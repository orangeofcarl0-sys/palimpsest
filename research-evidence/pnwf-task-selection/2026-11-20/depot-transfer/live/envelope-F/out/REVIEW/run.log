{"type":"tool_result","callId":"call_285084dc9644478988c242fc","status":"completed","result":"<path>/run/stage/world/model.mjs</path>\n<type>file</type>\n<content>\n1: const EPS = 1e-9;\n2: \n3: const round = (value, digits = 9) => {\n4:   const scale = 10 ** digits;\n5:   return Math.round((value + Number.EPSILON) * scale) / scale;\n6: };\n7: \n8: const sum = (values) => values.reduce((total, value) => total + value, 0);\n9: \n10: function chargingCaps(night, buildingKw) {\n11:   const siteLimitKw = Number(night.siteLimitKw);\n12:   const chargerKw = Number(night.chargerKw);\n13: \n14:   return buildingKw.map((load) =>\n15:     Math.max(0, Math.min(chargerKw, siteLimitKw - load)),\n16:   );\n17: }\n18: \n19: function shiftedBuilding(buildingKw, fromSlot, toSlot, shiftKw) {\n20:   const shifted = buildingKw.slice();\n21:   shifted[fromSlot] -= shiftKw;\n22:   shifted[toSlot] += shiftKw;\n23:   return shifted;\n24: }\n25: \n26: /**\n27:  * Greedy within each departure window: use the earliest available AC energy\n28:  * first and take only the remainder in later slots. This is physically valid,\n29:  * easy to execute, and leaves later capacity untouched whenever possible.\n30:  */\n31: function dispatch(night, caps, efficiency, slotHours) {\n32:   const acKw = Array(caps.length).fill(0);\n33:   const acEnergyLeft = caps.map((cap) => Math.max(0, cap) * slotHours);\n34:   let feasible = true;\n35: \n36:   for (const bus of night.buses) {\n37:     const fromSlot = Math.max(0, Number(bus.fromSlot));\n38:     const untilSlot = Math.min(caps.length, Number(bus.untilSlot));\n39:     const startKwh = Number(bus.startKwh);\n40:     const requiredKwh = Number(bus.requiredKwh);\n41:     const capacityKwh = Number(bus.capacityKwh);\n42: \n43:     const neededBatteryKwh = Math.max(0, requiredKwh - startKwh);\n44:     const batteryHeadroomKwh = Math.max(0, capacityKwh - startKwh);\n45:     const amountToDeliverBatteryKwh = Math.min(\n46:       neededBatteryKwh,\n47:       batteryHeadroomKwh,\n48:     );\n49: \n50:     let acEnergyToDeliver = amountToDeliverBatteryKwh / efficiency;\n51:     let deliveredAcEnergyKwh = 0;\n52: \n53:     for (let slot = fromSlot; slot < untilSlot && acEnergyToDeliver > EPS; slot += 1) {\n54:       const takeKwh = Math.min(acEnergyLeft[slot], acEnergyToDeliver);\n55:       acKw[slot] += takeKwh / slotHours;\n56:       acEnergyLeft[slot] -= takeKwh;\n57:       acEnergyToDeliver -= takeKwh;\n58:       deliveredAcEnergyKwh += takeKwh;\n59:     }\n60: \n61:     const deliveredBatteryKwh = deliveredAcEnergyKwh * efficiency;\n62:     if (\n63:       requiredKwh > capacityKwh + EPS ||\n64:       deliveredBatteryKwh + EPS < neededBatteryKwh\n65:     ) {\n66:       feasible = false;\n67:     }\n68:   }\n69: \n70:   return {\n71:     acKw: acKw.map((value) => round(Math.max(0, value))),\n72:     feasible,\n73:   };\n74: }\n75: \n76: function busWindow(bus, slotCount) {\n77:   const from = Math.max(0, Math.trunc(Number(bus.fromSlot)));\n78:   const until = Math.min(slotCount, Math.trunc(Number(bus.untilSlot)));\n79:   const slots = [];\n80:   for (let slot = from; slot < until; slot += 1) slots.push(slot);\n81:   return slots;\n82: }\n83: \n84: /**\n85:  * The only decision variable is the deferred building load s. On an interval\n86:  * between charger/site saturation breakpoints each charging cap is linear in\n87:  * s, so each bus's available AC energy is linear too. Intersect those linear\n88:  * inequalities to find the exact smallest feasible s.\n89:  */\n90: function minimumShift(night, coldBuildingKw, efficiency, slotHours) {\n91:   const fromSlot = Number(night.shiftFromSlot);\n92:   const toSlot = Number(night.shiftToSlot);\n93:   const slotCount = coldBuildingKw.length;\n94:   const maxShiftKw = Math.max(0, Number(night.maxShiftKw ?? 0));\n95: \n96:   if (\n97:     !Number.isInteger(fromSlot) ||\n98:     !Number.isInteger(toSlot) ||\n99:     fromSlot < 0 ||\n100:     fromSlot >= slotCount ||\n101:     toSlot < 0 ||\n102:     toSlot >= slotCount\n103:   ) {\n104:     return null;\n105:   }\n106: \n107:   for (const bus of night.buses) {\n108:     const requiredKwh = Number(bus.requiredKwh);\n109:     const capacityKwh = Number(bus.capacityKwh);\n110:     if (requiredKwh > capacityKwh + EPS) return null;\n111:   }\n112: \n113:   if (fromSlot === toSlot) {\n114:     const caps = chargingCaps(night, coldBuildingKw);\n115:     return dispatch(night, caps, efficiency, slotHours).feasible ? 0 : null;\n116:   }\n117: \n118:   const maxS = Math.max(\n119:     0,\n120:     Math.min(maxShiftKw, Number(coldBuildingKw[fromSlot])),\n121:   );\n122: \n123:   const capsAt = (shiftKw) => {\n124:     const building = shiftedBuilding(\n125:       coldBuildingKw,\n126:       fromSlot,\n127:       toSlot,\n128:       shiftKw,\n129:     );\n130:     return chargingCaps(night, building);\n131:   };\n132: \n133:   const satisfiesAt = (shiftKw) =>\n134:     dispatch(night, capsAt(shiftKw), efficiency, slotHours).feasible;\n135: \n136:   if (maxS <= EPS) return satisfiesAt(0) ? 0 : null;\n137: \n138:   const siteLimitKw = Number(night.siteLimitKw);\n139:   const chargerKw = Number(night.chargerKw);\n140:   const breakpoints = [0, maxS];\n141:   const addBreakpoint = (value) => {\n142:     if (Number.isFinite(value) && value > EPS && value < maxS - EPS) {\n143:       breakpoints.push(value);\n144:     }\n145:   };\n146: \n147:   const fromHeadroom = siteLimitKw - coldBuildingKw[fromSlot];\n148:   const toHeadroom = siteLimitKw - coldBuildingKw[toSlot];\n149: \n150:   // Kinks of min(chargerKw, siteLimit - load) at the source and target.\n151:   addBreakpoint(-fromHeadroom);\n152:   addBreakpoint(chargerKw - fromHeadroom);\n153:   addBreakpoint(toHeadroom - chargerKw);\n154:   addBreakpoint(toHeadroom);\n155: \n156:   const ordered = [...new Set(breakpoints.map((value) => round(value, 12)))]\n157:     .sort((a, b) => a - b);\n158: \n159:   for (const slot of ordered) {\n160:     if (satisfiesAt(slot)) return slot;\n161:   }\n162: \n163:   for (let index = 0; index < ordered.length - 1; index += 1) {\n164:     const left = ordered[index];\n165:     const right = ordered[index + 1];\n166:     if (right - left <= EPS) continue;\n167: \n168:     const capsLeft = capsAt(left);\n169:     const capsRight = capsAt(right);\n170:     const sourceSlope =\n171:       (capsRight[fromSlot] - capsLeft[fromSlot]) / (right - left);\n172:     const targetSlope =\n173:       (capsRight[toSlot] - capsLeft[toSlot]) / (right - left);\n174: \n175:     let lower = left;\n176:     let upper = right;\n177:     let possible = true;\n178: \n179:     for (const bus of night.buses) {\n180:       const window = busWindow(bus, slotCount);\n181:       const includesFrom = window.includes(fromSlot);\n182:       const includesTo = window.includes(toSlot);\n183:       const slope =\n184:         slotHours *\n185:         ((includesFrom ? sourceSlope : 0) + (includesTo ? targetSlope : 0));\n186:       const availableAtLeft =\n187:         slotHours * sum(window.map((slot) => capsLeft[slot]));\n188:       const intercept = availableAtLeft - slope * left;\n189:       const neededBatteryKwh = Math.max(\n190:         0,\n191:         Number(bus.requiredKwh) - Number(bus.startKwh),\n192:       );\n193:       const neededAcKwh = neededBatteryKwh / efficiency;\n194: \n195:       if (Math.abs(slope) <= EPS) {\n196:         if (intercept + EPS < neededAcKwh) {\n197:           possible = false;\n198:           break;\n199:         }\n200:       } else if (slope > 0) {\n201:         lower = Math.max(lower, (neededAcKwh - intercept) / slope);\n202:       } else {\n203:         upper = Math.min(upper, (neededAcKwh - intercept) / slope);\n204:       }\n205:     }\n206: \n207:     if (!possible) continue;\n208:     const candidate = Math.max(left, lower);\n209:     if (candidate <= upper + EPS && candidate <= right + EPS) {\n210:       if (satisfiesAt(candidate)) return round(candidate, 9);\n211:       if (satisfiesAt(right)) return round(right, 9);\n212:     }\n213:   }\n214: \n215:   return null;\n216: }\n217: \n218: export function plan(night, efficiency = night.efficiency) {\n219:   const eta = Number(efficiency);\n220:   const slotHours = Number(night.slotHours);\n221: \n222:   if (!(eta > 0 && eta <= 1)) {\n223:     throw new RangeError(\"efficiency must be in (0, 1]\");\n224:   }\n225:   if (!(slotHours > 0)) {\n226:     throw new RangeError(\"slotHours must be positive\");\n227:   }\n228: \n229:   const normalBuild","truncated":true}
{"type":"tool_result","callId":"call_31d4bd3f2a944003bbe0021b","status":"completed","result":"<path>/run/stage/world/model.test.mjs</path>\n<type>file</type>\n<content>\n1: import assert from \"node:assert/strict\";\n2: import fs from \"node:fs\";\n3: import test from \"node:test\";\n4: \n5: import { plan } from \"./model.mjs\";\n6: \n7: const night = JSON.parse(fs.readFileSync(new URL(\"./night.json\", import.meta.url)));\n8: const close = (actual, expected, tolerance = 1e-7) => {\n9:   assert.ok(\n10:     Math.abs(actual - expected) <= tolerance,\n11:     `expected ${expected}, got ${actual}`,\n12:   );\n13: };\n14: \n15: function caps(buildingKw) {\n16:   return buildingKw.map((load) =>\n17:     Math.max(0, Math.min(night.chargerKw, night.siteLimitKw - load)),\n18:   );\n19: }\n20: \n21: function batteryGain(scenario, bus, efficiency = night.efficiency) {\n22:   let acEnergy = 0;\n23:   for (let slot = bus.fromSlot; slot < bus.untilSlot; slot += 1) {\n24:     acEnergy += scenario.acKw[slot] * night.slotHours;\n25:   }\n26:   return acEnergy * efficiency;\n27: }\n28: \n29: function assertPhysical(scenario, buildingKw, efficiency = night.efficiency) {\n30:   assert.equal(scenario.acKw.length, night.slotStart.length);\n31:   const limits = caps(buildingKw);\n32: \n33:   scenario.acKw.forEach((power, slot) => {\n34:     assert.ok(power >= 0);\n35:     assert.ok(power <= limits[slot] + 1e-7);\n36:     assert.ok(buildingKw[slot] + power <= night.siteLimitKw + 1e-7);\n37:     const inWindow = night.buses.some(\n38:       (bus) => slot >= bus.fromSlot && slot < bus.untilSlot,\n39:     );\n40:     if (!inWindow) close(power, 0);\n41:   });\n42: \n43:   for (const bus of night.buses) {\n44:     let acEnergy = 0;\n45:     for (let slot = bus.fromSlot; slot < bus.untilSlot; slot += 1) {\n46:       acEnergy += scenario.acKw[slot] * night.slotHours;\n47:     }\n48:     const endKwh = bus.startKwh + acEnergy * efficiency;\n49:     assert.ok(endKwh <= bus.capacityKwh + 1e-7);\n50:     assert.ok(endKwh <= Math.max(bus.requiredKwh, bus.startKwh) + 1e-7);\n51:   }\n52: }\n53: \n54: test(\"90%: normal is feasible, cold needs exactly 20 kW moved, shifted is feasible\", () => {\n55:   const result = plan(night, 0.9);\n56: \n57:   assert.deepEqual(result.normal, {\n58:     acKw: [80, 40, 70, 50],\n59:     feasible: true,\n60:   });\n61:   assert.deepEqual(result.cold, {\n62:     acKw: [80, 20, 70, 50],\n63:     feasible: false,\n64:   });\n65:   assert.deepEqual(result.shifted, {\n66:     acKw: [80, 40, 70, 50],\n67:     feasible: true,\n68:   });\n69:   assert.equal(result.minShiftKw, 20);\n70: \n71:   assertPhysical(result.normal, night.buildingKw);\n72:   assertPhysical(\n73:     result.cold,\n74:     night.buildingKw.map((load, slot) => load + night.coldExtraKw[slot]),\n75:   );\n76:   assertPhysical(result.shifted, [40, 80, 50, 70]);\n77: \n78:   const [busA, busB] = night.buses;\n79:   close(busA.startKwh + batteryGain(result.shifted, busA), 126);\n80:   close(busB.startKwh + batteryGain(result.shifted, busB), 130);\n81: });\n82: \n83: test(\"unshifted cold gap is 9 kWh on bus A; B can cover its own departure\", () => {\n84:   const result = plan(night, 0.9);\n85:   const [busA, busB] = night.buses;\n86: \n87:   close(busA.startKwh + batteryGain(result.cold, busA), 117);\n88:   close(126 - (busA.startKwh + batteryGain(result.cold, busA)), 9);\n89:   close(busB.startKwh + batteryGain(result.cold, busB), 130);\n90: });\n91: \n92: test(\"85%: the shift cannot repair either scenario; optimum balance still leaves 3 kWh per bus\", () => {\n93:   const result = plan(night, 0.85);\n94:   const [busA, busB] = night.buses;\n95: \n96:   assert.equal(result.normal.feasible, false);\n97:   assert.equal(result.cold.feasible, false);\n98:   assert.equal(result.shifted, null);\n99:   assert.equal(result.minShiftKw, null);\n100: \n101:   assertPhysical(result.normal, night.buildingKw, 0.85);\n102:   assertPhysical(\n103:     result.cold,\n104:     night.buildingKw.map((load, slot) => load + night.coldExtraKw[slot]),\n105:     0.85,\n106:   );\n107: \n108:   close(busA.startKwh + batteryGain(result.normal, busA, 0.85), 123);\n109:   close(busA.startKwh + batteryGain(result.cold, busA, 0.85), 114.5);\n110:   close(busB.startKwh + batteryGain(result.cold, busB, 0.85), 130);\n111: });\n112: \n113: test(\"90% is the exact breakpoint: just above works, just below does not\", () => {\n114:   const above = plan(night, 0.900001);\n115:   const below = plan(night, 0.899999);\n116: \n117:   assert.equal(above.shifted.feasible, true);\n118:   assert.ok(above.minShiftKw < 20);\n119:   assert.ok(above.minShiftKw > 19.99);\n120: \n121:   assert.equal(below.normal.feasible, false);\n122:   assert.equal(below.shifted, null);\n123:   assert.equal(below.minShiftKw, null);\n124: });\n125: \n126: test(\"plan does not mutate the input and defaults to night.efficiency\", () => {\n127:   const snapshot = JSON.stringify(night);\n128:   const result = plan(night);\n129: \n130:   assert.equal(JSON.stringify(night), snapshot);\n131:   assert.equal(result.minShiftKw, 20);\n132: });\n\n(End of file - total 132 lines)\n</content>"}
