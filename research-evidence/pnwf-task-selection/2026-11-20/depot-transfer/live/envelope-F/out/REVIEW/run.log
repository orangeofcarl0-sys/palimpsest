{"type":"tool_call","callId":"call_472b1087e8c94effbf73bb28","tool":"bash","input":{"command":"node --input-type=module <<'NODE'\nimport fs from 'node:fs';\nconst night = JSON.parse(fs.readFileSync('night.json'));\nconst plan = JSON.parse(fs.readFileSync('shift-plan.json'));\nconst receipt = JSON.parse(fs.readFileSync('operations/revision-receipt.json'));\nconst release = JSON.parse(fs.readFileSync('release.json'));\nconst caps = receipt.limits;\nfunction calc(eta) {\n  const out = {};\n  for (const bus of night.buses) {\n    let ac = 0;\n    for (let s = bus.fromSlot; s < bus.untilSlot; s++) ac += plan.acKw[s] * night.slotHours;\n    const end = bus.startKwh + ac * eta;\n    out[bus.id] = {acKwh: ac, end: +end.toFixed(6), req: bus.requiredKwh, margin: +(end-bus.requiredKwh).toFixed(6)};\n  }\n  return out;\n}\nconsole.log('caps', caps);\nconsole.log('withinCaps', plan.acKw.every((k,i)=>k<=caps[i]));\nconsole.log('at90', calc(0.90));\nconsole.log('at85', calc(0.85));\nconsole.log('release', release);\nif (JSON.stringify(release.departureKwh) !== JSON.stringify([calc(0.90).A.end, calc(0.90).B.end])) throw new Error('departure mismatch');\nif (JSON.stringify(release.marginKwh) !== JSON.stringify([calc(0.90).A.margin, calc(0.90).B.margin])) throw new Error('margin mismatch');\nconsole.log('RELEASE_OK');\nNODE\nnode --test; echo \"TEST_EXIT:$?\"","description":"Validate release numbers and run model tests"}}
