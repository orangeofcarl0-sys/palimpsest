# Byte identity across platforms: all text files are LF in the working tree.
# The Python-parity checksums (test/contracts.test.ts) depend on this.
* text=auto eol=lf
*.png binary
*.ico binary
*.sqlite binary

# LHAPE runtime evidence is byte-identity evidence: do not normalize line endings.
research-evidence/lhape/** -text

# These manifests cover original Git, DSH, browser and journal bytes.
research-evidence/pnwf-software/2026-11-19/autonomous-continuity/** -text
research-evidence/pnwf-software/2026-11-19/fleet-rollout/** -text
# Empty unified-diff context lines consist of one space.
research-evidence/pnwf-software/2026-11-19/autonomous-continuity/*/candidate.patch whitespace=-blank-at-eol
